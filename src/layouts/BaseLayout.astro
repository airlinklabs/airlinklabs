---
import "../styles/tokens.css";
import "../styles/hovers.css";
import "../styles/animations.css";
import "../styles/layout.css";
import "../styles/prose.css";
import "../styles/components.css";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  bodyClass?: string;
}

const { title, description, pageTitle, bodyClass = "" } = Astro.props;

const underConstruction = site.underConstruction;
---

<!doctype html>
<html lang="en" class="dark">
  <Head
    pageTitle={pageTitle || title}
    site={site}
    underConstruction={underConstruction}
    pageDescription={description}
  />
  <body class={bodyClass}>
    {
      underConstruction?.enabled && (
        <div class="uc-bar">
          {underConstruction.badge}: {underConstruction.message}
        </div>
      )
    }

    <Nav />

    <slot />

    <script
      is:inline
      set:html={`window.__underConstruction = ${underConstruction?.enabled ? "true" : "false"};`}
    />
    <script is:inline src="/js/motion.js" defer></script>
    <script is:inline src="/js/main.js" defer></script>

    <!-- Iconify icon web component -->
    <script
      is:inline
      src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"
      defer></script>
  </body>
</html>
