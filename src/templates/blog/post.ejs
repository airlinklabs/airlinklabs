<%# Made by https://github.com/bthavanish %>
<%
  const rootPrefix = '../../';
  const pageTitle = post.title;
  const pageDescription = post.title + ' — ' + site.title + ' announcement.';
  const wordCount = post.content.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length;
  const readMins = Math.max(1, Math.round(wordCount / 200));
%>
<%- include('../partials/head', { site, underConstruction, rootPrefix, pageTitle, pageDescription }) %>
<%- include('../partials/nav', { site, underConstruction, rootPrefix, docPages, pageTitle }) %>

<%
  // Build sidebar links from announcements
  var sidebarLinks = [];
  if (announcements && announcements.length) {
    announcements.forEach(function(p) {
      sidebarLinks.push({
        label: p.title,
        href: rootPrefix + 'blog/' + p.slug + '/',
        active: p.slug === post.slug,
        searchText: p.title.toLowerCase()
      });
    });
  }
%>

<div class="docs-shell">
  <%- include('../partials/sidebar', { rootPrefix: rootPrefix, currentPage: 'blog', sidebarLinks: sidebarLinks, sidebarSectionLabel: 'All posts', docHeadings: post.headings || [] }) %>

  <main class="docs-main">
    <div class="docs-content" id="page-content">

      <div class="doc-breadcrumb">
        <a href="<%= rootPrefix %>blog/">Blog</a>
        <span class="sep">/</span>
        <span style="color:var(--color-text-2);"><%= post.title %></span>
      </div>

      <div class="doc-header">
        <h1 class="doc-title"><%= post.title %></h1>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px;">
          <% if (post.authorGithub) { %>
            <img src="https://github.com/<%= post.authorGithub %>.png?size=40" alt="" loading="lazy"
              style="width:22px;height:22px;border-radius:50%;background:var(--color-bg-3);flex-shrink:0;"
              onerror="this.style.display='none'">
          <% } %>
          <span style="font-size:12px;font-family:var(--font-mono);color:var(--color-text-2);"><%= post.author || 'AirlinkLabs' %></span>
          <% if (post.date) { %>
            <span style="font-size:12px;font-family:var(--font-mono);color:var(--color-text-4);">·</span>
            <span style="font-size:12px;font-family:var(--font-mono);color:var(--color-text-3);"><%= post.date %></span>
          <% } %>
          <span style="font-size:12px;font-family:var(--font-mono);color:var(--color-text-4);">·</span>
          <span style="font-size:12px;font-family:var(--font-mono);color:var(--color-text-3);"><%= readMins %> min read</span>
        </div>
      </div>

      <article class="prose">
        <%- post.content %>
      </article>

      <div style="margin-top:clamp(32px,5vw,56px);padding-top:20px;border-top:1px solid var(--color-border);">
        <a href="<%= rootPrefix %>blog/" class="doc-prev-next-link">
          <iconify-icon icon="lucide:arrow-left" width="11" height="11"></iconify-icon>
          All posts
        </a>
      </div>

    </div>
  </main>
</div>
