<%- include('../partials/head', { site, underConstruction, pageTitle: 'Documentation' ,
  pageDescription: 'Guides and reference for the AirLink community.' , rootPrefix: rootPrefix }) %>
  <%- include('../partials/nav', { site, underConstruction, pageTitle: 'Documentation' , rootPrefix: rootPrefix,
    docPages: docPages }) %>
    <% var sections={}; docPages.forEach(function(doc) { (sections[doc.section] ||=[]).push(doc); }); var
      names=Object.keys(sections).sort(function(a,b) { return sections[a][0].order - sections[b][0].order; }); var
      sidebarLinks=docPages.map(function(doc) { return { label: doc.title, href: rootPrefix + 'docs/' + doc.slug + '/' ,
      active: false, section: doc.section }; }); %>
      <div class="docs-shell"><%- include('../partials/sidebar', { rootPrefix: rootPrefix, currentPage: 'docs' ,
          sidebarLinks: sidebarLinks, sidebarSectionLabel: 'Documentation' }) %>
          <main class="docs-main">
            <div class="docs-content docs-index" id="page-content">
              <header class="docs-index-header" data-animate="fade-up">
                <h1>Documentation</h1>
                <p>Practical guides and reference material for running and contributing to AirLink.</p><label
                  class="docs-search"><svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"
                    viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                  </svg><input type="search" id="docs-search-input" placeholder="Search documentation"
                    autocomplete="off"><kbd id="search-kbd">Ctrl K</kbd></label>
              </header>
              <div id="docs-list">
                <% names.forEach(function(section) { %>
                  <section class="docs-group">
                    <h2>
                      <%= section %>
                    </h2>
                    <div class="docs-list">
                      <% sections[section].forEach(function(doc) { %><a href="<%= rootPrefix %>docs/<%= doc.slug %>/"
                          class="docs-list-row"
                          data-search-text="<%= (doc.title + ' ' + doc.description + ' ' + doc.section).toLowerCase() %>">
                          <div>
                            <p>
                              <%= doc.title %>
                            </p><span>
                              <%= doc.description %>
                            </span>
                          </div><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"
                            viewBox="0 0 24 24">
                            <path d="M5 12h14m-6-6 6 6-6 6" />
                          </svg>
                        </a>
                        <% }); %>
                    </div>
                  </section>
                  <% }); %>
              </div>
              <div id="docs-search-no-results" class="empty-state" style="display:none"><svg width="32" height="32"
                  fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5" />
                </svg>
                <p>No results found. Try a different search term.</p>
              </div>
            </div>
          </main>
      </div>
      <script>(function () { var kbd = document.getElementById('search-kbd'); if (kbd && navigator.platform && /Mac|iPhone|iPad|iPod/.test(navigator.platform)) { kbd.textContent = '⌘ K' } var input = document.getElementById('docs-search-input'); var noResults = document.getElementById('docs-search-no-results'); if (!input) return; input.addEventListener('input', function () { var q = input.value.toLowerCase().trim(); var visibleCount = 0; document.querySelectorAll('.docs-list-row').forEach(function (row) { var visible = !q || row.dataset.searchText.includes(q); row.hidden = !visible; if (visible) visibleCount++ }); document.querySelectorAll('.docs-group').forEach(function (group) { group.hidden = !!q && !group.querySelector('.docs-list-row:not([hidden])') }); if (noResults) { noResults.style.display = visibleCount === 0 && q.length > 0 ? '' : 'none' } }); document.addEventListener('keydown', function (e) { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input.focus() } }) })();</script>