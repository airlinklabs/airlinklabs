<%
const rootPrefix = '../';
const pageTitle = 'Docs';
const pageDescription = 'AirLink Panel documentation.';
%>
<%- include('./partials/head', { site, underConstruction, rootPrefix, pageTitle, pageDescription }) %>
<%- include('./partials/nav', { site, underConstruction, rootPrefix, docPages, pageTitle }) %>

<style>
  .docs-layout {
    min-height: 100vh;
    display: flex;
    padding: clamp(32px,5vw,72px) clamp(16px,4vw,56px) clamp(32px,5vw,72px) clamp(16px,4vw,56px);
    box-sizing: border-box;
    gap: clamp(24px,5vw,72px);
  }

  @media (max-width: 600px) {
    .docs-layout {
      padding-bottom: 84px;
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  @media (min-width: 860px) {
    .docs-layout {
      margin-left: 60px;
    }
  }

  .docs-sidebar {
    display: none;
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: clamp(32px,5vw,72px);
    align-self: flex-start;
  }

  @media (min-width: 860px) {
    .docs-sidebar { display: block; }
  }

  .docs-sidebar-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 10px;
  }

  .docs-sidebar-link {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 8px;
    text-decoration: none;
    margin-bottom: 2px;
    transition: background 120ms;
  }

  .docs-sidebar-link:hover { background: var(--color-bg-hover); }

  .docs-sidebar-link .bar {
    width: 2px;
    min-height: 16px;
    border-radius: 999px;
    background: var(--color-border-input);
    flex-shrink: 0;
    margin-top: 3px;
    align-self: stretch;
  }

  .docs-sidebar-link .title {
    font-size: 12px;
    color: var(--color-text-3);
    line-height: 1.4;
  }

  .docs-sidebar-link .desc {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-4);
    margin-top: 2px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .docs-main {
    flex: 1;
    min-width: 0;
  }
</style>

<div class="docs-layout">

  <% if (docPages && docPages.length) { %>
  <aside class="docs-sidebar">
    <p class="docs-sidebar-label">Documentation</p>
    <% docPages.forEach(function(doc) { %>
    <a href="<%= rootPrefix %>docs/<%= doc.slug %>/" class="docs-sidebar-link">
      <span class="bar"></span>
      <div style="min-width:0;">
        <p class="title"><%= doc.title %></p>
        <% if (doc.description) { %><p class="desc"><%= doc.description %></p><% } %>
      </div>
    </a>
    <% }) %>
  </aside>
  <% } %>

  <main class="docs-main">

    <div style="padding:0 0 clamp(20px,3vw,40px);border-bottom:1px solid var(--color-border);margin-bottom:clamp(24px,3vw,48px);">
      <p style="font-size:10px;font-family:var(--font-mono);color:var(--color-text-3);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 10px;">Reference</p>
      <h1 style="font-size:clamp(28px,4vw,48px);font-weight:600;color:var(--color-text-1);letter-spacing:-0.035em;margin:0;">Documentation</h1>
    </div>

    <% if (docPages && docPages.length) { %>
    <div>
      <% docPages.forEach(function(doc) { %>
      <a href="<%= rootPrefix %>docs/<%= doc.slug %>/"
        style="display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:18px 0;border-bottom:1px solid var(--color-border);text-decoration:none;transition:padding-left 150ms;"
        onmouseover="this.style.paddingLeft='8px'" onmouseout="this.style.paddingLeft='0'">
        <div style="flex:1;min-width:0;">
          <h2 style="font-size:14px;font-weight:600;color:var(--color-text-1);letter-spacing:-0.01em;margin:0 0 4px;"><%= doc.title %></h2>
          <% if (doc.description) { %>
          <p style="font-size:12px;color:var(--color-text-3);margin:0;line-height:1.5;"><%= doc.description %></p>
          <% } %>
        </div>
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--color-text-4);flex-shrink:0;margin-top:2px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <p style="font-size:13px;font-family:var(--font-mono);color:var(--color-text-3);">No doc pages yet.</p>
    <% } %>

  </main>

</div>

<script src="<%= rootPrefix %>public/js/main.js"></script>
</body>
</html>
