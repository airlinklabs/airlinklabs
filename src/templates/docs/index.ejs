<%- include('../partials/head', { pageTitle: 'Documentation', pageDescription: 'Everything you need to set up, configure, and manage your AirLink panel.', rootPrefix: '../../' }) %>
<%- include('../partials/nav', { pageTitle: 'Documentation', rootPrefix: '../../' }) %>

<%
  // Build sidebar links grouped by section
  var sections = {};
  docPages.forEach(function(doc) {
    if (!sections[doc.section]) sections[doc.section] = [];
    sections[doc.section].push(doc);
  });
  var sortedSectionNames = Object.keys(sections).sort(function(a, b) {
    return sections[a][0].order - sections[b][0].order;
  });
  var sidebarLinks = [];
  sortedSectionNames.forEach(function(section) {
    sections[section].forEach(function(doc) {
      sidebarLinks.push({
        label: doc.title,
        href: rootPrefix + 'docs/' + doc.slug + '/',
        active: false,
        searchText: doc.title.toLowerCase() + ' ' + doc.description.toLowerCase()
      });
    });
  });
%>

<div class="docs-shell">
  <%- include('../partials/sidebar', { rootPrefix: rootPrefix, currentPage: 'docs', sidebarLinks: sidebarLinks, sidebarSectionLabel: 'Documentation' }) %>

  <!-- Main content -->
  <main class="docs-main">
    <div class="docs-content" id="page-content">
      <div class="doc-header">
        <h1 class="doc-title" style="font-size:32px;margin-bottom:4px;">Documentation</h1>
        <p class="doc-desc">Everything you need to set up, configure, and manage your AirLink panel.</p>
      </div>

      <% sortedSectionNames.forEach(function(section) { %>
        <h2 class="docs-section-heading" data-animate="fade-up"><%= section %></h2>
        <div class="docs-card-grid" data-animate-group>
          <% sections[section].forEach(function(doc) { %>
            <a href="<%= rootPrefix %>docs/<%= doc.slug %>/" class="docs-card">
              <div class="docs-card-title"><%= doc.title %></div>
              <div class="docs-card-desc"><%= doc.description %></div>
              <% if (doc.author) { %><span class="docs-card-badge"><%= doc.author %></span><% } %>
            </a>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </main>
</div>

<script>
// Sidebar search
(function () {
  var input = document.getElementById('doc-search');
  if (!input) return;
  var links = document.querySelectorAll('.site-section-link');
  input.addEventListener('input', function () {
    var q = input.value.toLowerCase().trim();
    links.forEach(function (link) {
      var text = link.dataset.searchText || link.textContent.toLowerCase();
      link.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
  });
})();
</script>

<%- include('../partials/footer', { rootPrefix: '../../' }) %>
