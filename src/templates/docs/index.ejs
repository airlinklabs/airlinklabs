<%
const rootPrefix = '../';
const pageTitle = 'Docs';
const pageDescription = 'AirLink Panel documentation.';

const sections = {};
(docPages || []).forEach(function(doc) {
  var s = doc.section || 'General';
  if (!sections[s]) sections[s] = [];
  sections[s].push(doc);
});
%>
<%- include('./partials/head', { site, underConstruction, rootPrefix, pageTitle, pageDescription }) %>
<%- include('./partials/nav', { site, underConstruction, rootPrefix, docPages, pageTitle }) %>

<style>
  .docs-layout {
    min-height: 100vh;
    display: flex;
    padding: clamp(32px,5vw,72px) clamp(16px,4vw,56px) clamp(32px,5vw,72px) clamp(16px,4vw,56px);
    box-sizing: border-box;
    gap: clamp(24px,5vw,72px);
  }

  @media (max-width: 600px) {
    .docs-layout {
      padding-bottom: 84px;
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  @media (min-width: 860px) {
    .docs-layout {
      margin-left: 60px;
    }
  }

  .docs-sidebar {
    display: none;
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: clamp(32px,5vw,72px);
    align-self: flex-start;
  }

  @media (min-width: 860px) {
    .docs-sidebar { display: block; }
  }

  .docs-sidebar-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 10px;
  }

  .docs-search {
    width: 100%;
    padding: 8px 10px;
    font-size: 12px;
    font-family: var(--font-mono);
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-1);
    outline: none;
    margin-bottom: 16px;
    box-sizing: border-box;
  }

  .docs-search::placeholder { color: var(--color-text-4); }
  .docs-search:focus { border-color: var(--color-text-3); }

  .docs-sidebar-link {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 8px;
    text-decoration: none;
    margin-bottom: 2px;
    transition: background 120ms;
  }

  .docs-sidebar-link:hover { background: var(--color-bg-hover); }

  .docs-sidebar-link .bar {
    width: 2px;
    min-height: 16px;
    border-radius: 999px;
    background: var(--color-border-input);
    flex-shrink: 0;
    margin-top: 3px;
    align-self: stretch;
  }

  .docs-sidebar-link .title {
    font-size: 12px;
    color: var(--color-text-3);
    line-height: 1.4;
  }

  .docs-sidebar-link .desc {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-4);
    margin-top: 2px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .docs-main {
    flex: 1;
    min-width: 0;
  }

  .docs-section-group {
    margin-bottom: clamp(32px,4vw,56px);
  }

  .docs-section-title {
    font-size: clamp(14px,2vw,18px);
    font-weight: 600;
    color: var(--color-text-1);
    letter-spacing: -0.02em;
    margin: 0 0 clamp(12px,1.5vw,20px);
    padding: 8px 14px;
    background: var(--color-bg-2);
    border-radius: 8px;
    border-left: 3px solid var(--color-text-3);
  }

  .docs-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(10px,1.5vw,16px);
  }

  .docs-card {
    display: flex;
    flex-direction: column;
    padding: 16px 18px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 200ms, box-shadow 200ms;
  }

  .docs-card:hover {
    border-color: var(--color-text-3);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .docs-card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-1);
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  .docs-card-desc {
    font-size: 12px;
    color: var(--color-text-3);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 859px) {
    .docs-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="docs-layout">

  <% if (docPages && docPages.length) { %>
  <aside class="docs-sidebar">
    <input type="text" id="docs-search" placeholder="Search docs..." class="docs-search">
    <p class="docs-sidebar-label">Documentation</p>
    <% docPages.forEach(function(doc) { %>
    <a href="<%= rootPrefix %>docs/<%= doc.slug %>/" class="docs-sidebar-link">
      <span class="bar"></span>
      <div style="min-width:0;">
        <p class="title"><%= doc.title %></p>
        <% if (doc.description) { %><p class="desc"><%= doc.description %></p><% } %>
      </div>
    </a>
    <% }) %>
  </aside>
  <% } %>

  <main class="docs-main">

    <div style="padding:0 0 clamp(20px,3vw,40px);border-bottom:1px solid var(--color-border);margin-bottom:clamp(24px,3vw,48px);">
      <p style="font-size:10px;font-family:var(--font-mono);color:var(--color-text-3);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 10px;">Reference</p>
      <h1 style="font-size:clamp(28px,4vw,48px);font-weight:600;color:var(--color-text-1);letter-spacing:-0.035em;margin:0;">Documentation</h1>
    </div>

    <% if (docPages && docPages.length) { %>
      <% Object.entries(sections).forEach(function([section, docs]) { %>
      <div class="docs-section-group">
        <h2 class="docs-section-title"><%= section %></h2>
        <div class="docs-card-grid">
          <% docs.forEach(function(doc) { %>
          <a href="<%= rootPrefix %>docs/<%= doc.slug %>/" class="docs-card">
            <h3 class="docs-card-title"><%= doc.title %></h3>
            <% if (doc.description) { %><p class="docs-card-desc"><%= doc.description %></p><% } %>
          </a>
          <% }) %>
        </div>
      </div>
      <% }) %>
    <% } else { %>
    <p style="font-size:13px;font-family:var(--font-mono);color:var(--color-text-3);">No doc pages yet.</p>
    <% } %>

  </main>

</div>

<script src="<%= rootPrefix %>public/js/main.js"></script>
</body>
</html>
