<%- include('../partials/head', { pageTitle: 'Documentation', pageDescription: 'Everything you need to set up, configure, and manage your AirLink panel.', rootPrefix: '../../' }) %>
<%- include('../partials/nav', { pageTitle: 'Documentation', rootPrefix: '../../' }) %>

<div class="docs-shell">
  <!-- Sidebar -->
  <aside class="docs-sidebar">
    <div class="docs-sidebar-header">
      <a href="<%= rootPrefix %>" class="docs-sidebar-logo">
        <img src="<%= rootPrefix %>public/assets/icon.png" alt="" width="22" height="22">
        AirLink
      </a>
      <div class="docs-sidebar-search">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="doc-search" placeholder="Search docs..." autocomplete="off">
      </div>
    </div>
    <nav class="docs-sidebar-nav" id="doc-sidebar-nav">
      <% var sections = {}; %>
      <% docPages.forEach(function(doc) { %>
        <% if (!sections[doc.section]) sections[doc.section] = []; %>
        <% sections[doc.section].push(doc); %>
      <% }); %>
      <% Object.keys(sections).sort(function(a, b) { %>
        <% var orderA = sections[a][0].order; %>
        <% var orderB = sections[b][0].order; %>
        <% return orderA - orderB; %>
      <% }).forEach(function(section) { %>
        <div class="docs-sidebar-section-label"><%= section %></div>
        <% sections[section].forEach(function(doc) { %>
          <a href="<%= rootPrefix %>docs/<%= doc.slug %>/" class="docs-sidebar-link" data-doc-title="<%= doc.title.toLowerCase() %>" data-doc-desc="<%= doc.description.toLowerCase() %>">
            <%= doc.title %>
          </a>
        <% }); %>
      <% }); %>
    </nav>
  </aside>

  <!-- Main content -->
  <main class="docs-main">
    <div class="docs-content" id="page-content">
      <div class="doc-header">
        <h1 class="doc-title" style="font-size:32px;margin-bottom:4px;">Documentation</h1>
        <p class="doc-desc">Everything you need to set up, configure, and manage your AirLink panel.</p>
      </div>

      <% var sortedSections = Object.keys(sections).sort(function(a, b) { return sections[a][0].order - sections[b][0].order; }); %>
      <% sortedSections.forEach(function(section) { %>
        <h2 class="docs-section-heading"><%= section %></h2>
        <div class="docs-card-grid">
          <% sections[section].forEach(function(doc) { %>
            <a href="<%= rootPrefix %>docs/<%= doc.slug %>/" class="docs-card">
              <div class="docs-card-title"><%= doc.title %></div>
              <div class="docs-card-desc"><%= doc.description %></div>
              <% if (doc.author) { %><span class="docs-card-badge"><%= doc.author %></span><% } %>
            </a>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </main>
</div>

<script>
// Sidebar search — filter docs in-place
(function () {
  var input = document.getElementById('doc-search');
  var nav = document.getElementById('doc-sidebar-nav');
  if (!input || !nav) return;

  var links = nav.querySelectorAll('.docs-sidebar-link');
  var sections = nav.querySelectorAll('.docs-sidebar-section-label');

  input.addEventListener('input', function () {
    var q = input.value.toLowerCase().trim();
    links.forEach(function (link) {
      var match = !q || link.dataset.docTitle.includes(q) || link.dataset.docDesc.includes(q);
      link.style.display = match ? '' : 'none';
    });
    // Hide empty section labels
    sections.forEach(function (label) {
      var next = label.nextElementSibling;
      var hasVisible = false;
      while (next && !next.classList.contains('docs-sidebar-section-label')) {
        if (next.classList.contains('docs-sidebar-link') && next.style.display !== 'none') {
          hasVisible = true;
        }
        next = next.nextElementSibling;
      }
      label.style.display = hasVisible || !q ? '' : 'none';
    });
  });
})();
</script>

<%- include('../partials/footer', { rootPrefix: '../../' }) %>
