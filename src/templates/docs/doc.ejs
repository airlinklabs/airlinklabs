<%- include('../partials/head', { pageTitle: currentDoc.title, pageDescription: currentDoc.description, rootPrefix: '../../../' }) %>
<%- include('../partials/nav', { pageTitle: currentDoc.title, rootPrefix: '../../../' }) %>

<%
  // Find prev/next docs by order
  var currentIdx = docPages.findIndex(function(d) { return d.slug === currentDoc.slug; });
  var prevDoc = currentIdx > 0 ? docPages[currentIdx - 1] : null;
  var nextDoc = currentIdx < docPages.length - 1 ? docPages[currentIdx + 1] : null;

  // Build sidebar links grouped by section
  var sidebarSections = {};
  docPages.forEach(function(doc) {
    if (!sidebarSections[doc.section]) sidebarSections[doc.section] = [];
    sidebarSections[doc.section].push(doc);
  });
  var sortedSectionNames = Object.keys(sidebarSections).sort(function(a, b) {
    return sidebarSections[a][0].order - sidebarSections[b][0].order;
  });
  var sidebarLinks = [];
  sortedSectionNames.forEach(function(section) {
    sidebarSections[section].forEach(function(doc) {
      sidebarLinks.push({
        label: doc.title,
        href: rootPrefix + 'docs/' + doc.slug + '/',
        active: doc.slug === currentDoc.slug,
        searchText: doc.title.toLowerCase() + ' ' + doc.description.toLowerCase()
      });
    });
  });
%>

<div class="docs-shell">
  <%- include('../partials/sidebar', { rootPrefix: rootPrefix, currentPage: 'docs', sidebarLinks: sidebarLinks, sidebarSectionLabel: 'Documentation' }) %>

  <!-- Main content -->
  <main class="docs-main">
    <div class="docs-content" id="page-content">
      <!-- Breadcrumb -->
      <div class="doc-breadcrumb">
        <a href="<%= rootPrefix %>docs/">Docs</a>
        <span class="sep">/</span>
        <span><%= currentDoc.section %></span>
        <span class="sep">/</span>
        <span style="color:var(--color-text-2);"><%= currentDoc.title %></span>
      </div>

      <!-- Header -->
      <div class="doc-header">
        <span class="doc-section-badge"><%= currentDoc.section %></span>
        <h1 class="doc-title"><%= currentDoc.title %></h1>
        <% if (currentDoc.description) { %>
          <p class="doc-desc"><%= currentDoc.description %></p>
        <% } %>
        <% if (currentDoc.author || currentDoc.date) { %>
          <div class="doc-meta">
            <% if (currentDoc.author) { %><span>by <%= currentDoc.author %></span><% } %>
            <% if (currentDoc.date) { %><span><%= currentDoc.date %></span><% } %>
          </div>
        <% } %>
      </div>

      <!-- Article content -->
      <article class="prose" id="doc-article">
        <%- currentDoc.content %>
      </article>

      <!-- Prev / Next -->
      <div class="doc-prev-next">
        <% if (prevDoc) { %>
          <a href="<%= rootPrefix %>docs/<%= prevDoc.slug %>/" class="btn-secondary">
            <span class="label">&larr; Previous</span>
            <span class="title"><%= prevDoc.title %></span>
          </a>
        <% } else { %><div></div><% } %>
        <% if (nextDoc) { %>
          <a href="<%= rootPrefix %>docs/<%= nextDoc.slug %>/" class="btn-secondary next">
            <span class="label">Next &rarr;</span>
            <span class="title"><%= nextDoc.title %></span>
          </a>
        <% } else { %><div></div><% } %>
      </div>
    </div>
  </main>

  <!-- TOC (right sidebar) -->
  <% if (currentDoc.headings && currentDoc.headings.length > 0) { %>
  <aside class="doc-toc" id="doc-toc">
    <div class="doc-toc-title">On this page</div>
    <% currentDoc.headings.forEach(function(h) { %>
      <a href="#<%= h.id %>" class="doc-toc-link toc-h<%= h.level %>" data-toc-id="<%= h.id %>"><%= h.text %></a>
    <% }); %>
  </aside>
  <% } %>

  <!-- Back to top -->
  <button class="doc-back-top" id="doc-back-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
  </button>
</div>

<script>
// ── Scroll-spy: highlight active TOC link ────────────────────────────────
(function () {
  var toc = document.getElementById('doc-toc');
  if (!toc) return;
  var tocLinks = toc.querySelectorAll('.doc-toc-link');
  var ids = Array.from(tocLinks).map(function (l) { return l.dataset.tocId; });
  var targets = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean);
  if (!targets.length) return;

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        var id = entry.target.id;
        tocLinks.forEach(function (link) {
          link.classList.toggle('active', link.dataset.tocId === id);
        });
      }
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  targets.forEach(function (t) { observer.observe(t); });
})();

// ── Back to top button ──────────────────────────────────────────────────
(function () {
  var btn = document.getElementById('doc-back-top');
  if (!btn) return;
  window.addEventListener('scroll', function () {
    btn.classList.toggle('visible', window.scrollY > 300);
  }, { passive: true });
})();

// ── Sidebar search ──────────────────────────────────────────────────────
(function () {
  var input = document.getElementById('doc-search');
  var nav = document.getElementById('doc-sidebar-nav');
  if (!input || !nav) return;

  var links = nav.querySelectorAll('.site-section-link');
  input.addEventListener('input', function () {
    var q = input.value.toLowerCase().trim();
    links.forEach(function (link) {
      var text = link.dataset.searchText || link.textContent.toLowerCase();
      link.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
  });
})();
</script>

<%- include('../partials/footer', { rootPrefix: '../../../' }) %>
