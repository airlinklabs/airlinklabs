<%
const rootPrefix = '../../';
const pageTitle = currentDoc.title;
const pageDescription = currentDoc.description || site.description;
%>
<%- include('./partials/head', { site, underConstruction, rootPrefix, pageTitle, pageDescription }) %>
<%- include('./partials/nav', { site, underConstruction, rootPrefix, docPages, pageTitle }) %>

<style>
  .doc-layout {
    min-height: 100vh;
    display: flex;
    padding: clamp(32px,5vw,72px) clamp(20px,4vw,56px) clamp(32px,5vw,72px) clamp(20px,4vw,56px);
    box-sizing: border-box;
    gap: clamp(32px,5vw,72px);
  }

  @media (max-width: 600px) {
    .doc-layout {
      padding-bottom: 84px;
    }
  }

  @media (min-width: 860px) {
    .doc-layout {
      margin-left: 60px;
    }
  }

  .doc-sidebar {
    display: none;
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: clamp(32px,5vw,72px);
    align-self: flex-start;
  }

  @media (min-width: 860px) {
    .doc-sidebar { display: block; }
  }

  .doc-sidebar-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 10px;
  }

  .doc-sidebar-link {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 8px;
    text-decoration: none;
    margin-bottom: 2px;
    transition: background 120ms;
  }

  .doc-sidebar-link:hover { background: var(--color-bg-hover); }

  .doc-sidebar-link--active {
    background: var(--color-bg-2);
    border: 1px solid var(--color-border);
  }

  .doc-sidebar-link .bar {
    width: 2px;
    min-height: 16px;
    border-radius: 999px;
    background: var(--color-border-input);
    flex-shrink: 0;
    margin-top: 3px;
    align-self: stretch;
  }

  .doc-sidebar-link--active .bar {
    background: var(--color-text-1);
  }

  .doc-sidebar-link .title {
    font-size: 12px;
    color: var(--color-text-3);
    line-height: 1.4;
  }

  .doc-sidebar-link--active .title {
    color: var(--color-text-1);
    font-weight: 500;
  }

  .doc-sidebar-link .desc {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-4);
    margin-top: 2px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .doc-main {
    flex: 1;
    min-width: 0;
  }
</style>

<div class="doc-layout">

  <aside class="doc-sidebar">
    <p class="doc-sidebar-label">Documentation</p>
    <% docPages.forEach(function(doc) { %>
    <a href="<%= rootPrefix %>docs/<%= doc.slug %>/"
      class="doc-sidebar-link <%= doc.slug === currentDoc.slug ? 'doc-sidebar-link--active' : '' %>">
      <span class="bar"></span>
      <div style="min-width:0;">
        <p class="title"><%= doc.title %></p>
        <% if (doc.description && doc.slug !== currentDoc.slug) { %><p class="desc"><%= doc.description %></p><% } %>
      </div>
    </a>
    <% }) %>
  </aside>

  <main class="doc-main">

    <div style="padding:0 0 clamp(20px,3vw,40px);border-bottom:1px solid var(--color-border);margin-bottom:clamp(24px,3vw,48px);">

      <a href="<%= rootPrefix %>docs/"
        style="display:inline-flex;align-items:center;gap:6px;font-size:11px;font-family:var(--font-mono);color:var(--color-text-3);text-decoration:none;margin-bottom:clamp(16px,2.5vw,28px);"
        onmouseover="this.style.color='var(--color-text-1)'" onmouseout="this.style.color='var(--color-text-3)'">
        <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Docs
      </a>

      <p style="font-size:10px;font-family:var(--font-mono);color:var(--color-text-3);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 10px;">Documentation</p>
      <h1 style="font-size:clamp(22px,3.5vw,36px);font-weight:600;color:var(--color-text-1);letter-spacing:-0.03em;margin:0 0 12px;"><%= currentDoc.title %></h1>
      <% if (currentDoc.description) { %>
      <p style="font-size:14px;color:var(--color-text-3);line-height:1.65;margin:0 0 12px;"><%= currentDoc.description %></p>
      <% } %>
      <% if (currentDoc.author || currentDoc.date) { %>
      <div style="display:flex;align-items:center;gap:8px;font-size:11px;font-family:var(--font-mono);color:var(--color-text-4);">
        <% if (currentDoc.author) { %>
        <img src="https://github.com/<%= currentDoc.author %>.png?size=20" alt="" loading="lazy" style="width:16px;height:16px;border-radius:50%;background:var(--color-bg-3);" onerror="this.style.display='none'">
        <span style="color:var(--color-text-3);"><%= currentDoc.author %></span>
        <% } %>
        <% if (currentDoc.date) { %>
        <% if (currentDoc.author) { %><span>·</span><% } %>
        <span><%= currentDoc.date %></span>
        <% } %>
      </div>
      <% } %>
    </div>

    <article class="prose">
      <%- currentDoc.content %>
    </article>

    <%
      var currentIdx = docPages.findIndex(function(d) { return d.slug === currentDoc.slug; });
      var prev = currentIdx > 0 ? docPages[currentIdx - 1] : null;
      var next = currentIdx < docPages.length - 1 ? docPages[currentIdx + 1] : null;
    %>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:clamp(32px,4vw,56px);padding-top:24px;border-top:1px solid var(--color-border);">
      <% if (prev) { %>
      <a href="<%= rootPrefix %>docs/<%= prev.slug %>/"
        style="display:flex;align-items:center;gap:7px;font-size:12px;color:var(--color-text-3);text-decoration:none;"
        onmouseover="this.style.color='var(--color-text-1)'" onmouseout="this.style.color='var(--color-text-3)'">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        <%= prev.title %>
      </a>
      <% } else { %><div></div><% } %>
      <% if (next) { %>
      <a href="<%= rootPrefix %>docs/<%= next.slug %>/"
        style="display:flex;align-items:center;gap:7px;font-size:12px;color:var(--color-text-3);text-decoration:none;"
        onmouseover="this.style.color='var(--color-text-1)'" onmouseout="this.style.color='var(--color-text-3)'">
        <%= next.title %>
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <% } else { %><div></div><% } %>
    </div>

  </main>

</div>

<script src="<%= rootPrefix %>public/js/main.js"></script>
</body>
</html>
