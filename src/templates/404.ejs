<% const rootPrefix='' ; const pageTitle='404' ; const pageDescription='Page not found — ' + site.title; const
    siteBase=(site.siteUrl || '' ).replace(/\/$/, '' ); %>
    <%- include('./partials/head', { site, underConstruction, rootPrefix, pageTitle, pageDescription }) %><%-
            include('./partials/nav', { site, underConstruction, rootPrefix, docPages, pageTitle }) %>
            <div class="docs-shell"><%- include('./partials/sidebar', { rootPrefix: rootPrefix, currentPage: '' ,
                    sidebarLinks: [], sidebarSectionLabel: '' }) %>
                    <main class="docs-main">
                        <div class="not-found" id="page-content" data-animate="blur">
                            <p class="not-found-code">404 / ROUTE_MISSING</p>
                            <h1>Page not found.</h1>
                            <p>This page may have moved or been removed. The rest of the site is where you left it.</p>
                            <div><a href="<%= siteBase %>/" class="btn-primary">Back to home <svg width="16" height="16"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M5 12h14" />
                                        <path d="m12 5 7 7-7 7" />
                                    </svg></a><a href="<%= siteBase %>/docs/" class="btn-secondary">Read the docs</a>
                            </div><code id="not-found-path"></code>
                        </div>
                    </main>
            </div>
            <script>document.getElementById('not-found-path').textContent = window.location.pathname || '/'</script>