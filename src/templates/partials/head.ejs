<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= pageTitle ? pageTitle + ' — ' + site.title : site.title + ' — ' + site.description.split('.')[0] %></title>
  <meta name="description" content="<%= pageDescription || site.description %>">
  <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)">
  <link rel="icon" href="<%= rootPrefix %>public/assets/favicon.ico" type="image/x-icon">
  <link rel="icon" href="<%= rootPrefix %>public/assets/icon.png"   type="image/png" sizes="any">

  <%
    var _siteUrl   = (site.siteUrl || '').replace(/\/$/, '');
    var _pageTitle = pageTitle ? pageTitle + ' — ' + site.title : site.title;
    var _pageDesc  = pageDescription || site.description;
    var _ogImage   = _siteUrl + '/public/assets/icon.png';
    // canonical: siteUrl + path derived from rootPrefix depth
    var _depth     = (rootPrefix.match(/\.\.\//g) || []).length;
    var _canonical = _siteUrl + (rootPrefix === '' ? '/' : ('/' + Array(_depth).fill('').join('')));
  %>

  <!-- Open Graph — used by Discord, GitHub, and most link previewers -->
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="<%= site.title %>">
  <meta property="og:title"       content="<%= _pageTitle %>">
  <meta property="og:description" content="<%= _pageDesc %>">
  <meta property="og:image"       content="<%= _ogImage %>">
  <% if (_siteUrl) { %><meta property="og:url" content="<%= _canonical %>"><% } %>

  <link rel="stylesheet" href="<%= rootPrefix %>public/css/styles.css">
  <link rel="preload" as="image" href="<%= rootPrefix %>public/assets/icon.png">
  <% if (!pageTitle) { %>
  <link rel="preload" as="image" href="<%= rootPrefix %>public/assets/airlink-hero.png">
  <% } %>

  <% if (underConstruction && underConstruction.enabled) { %>
  <style>
    .uc-bar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 9999;
      background: var(--color-warning);
      color: #000;
      font-size: 12px;
      font-family: var(--font-mono);
      text-align: center;
      padding: 6px 16px;
    }
  </style>
  <% } %>
</head>
<body>

<% if (underConstruction && underConstruction.enabled) { %>
<div class="uc-bar"><%= underConstruction.badge %>: <%= underConstruction.message %></div>
<% } %>

<script src="<%= rootPrefix %>public/js/motion.js" defer></script>
<script src="<%= rootPrefix %>public/js/main.js" defer></script>
<!-- mermaid: renders ```mermaid graph blocks in docs/blog content -->
<script type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
  mermaid.initialize({
    startOnLoad: true,
    theme: 'dark',
    darkMode: true,
    securityLevel: 'loose',
    fontFamily: 'ui-monospace, "SF Mono", "Fira Code", monospace',
    flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'cardinal' },
    themeVariables: {
      primaryColor: '#1e40af',
      primaryTextColor: '#e0e0e0',
      primaryBorderColor: '#3b82f6',
      lineColor: '#60a5fa',
      secondaryColor: '#7c2d12',
      tertiaryColor: '#1e3a5f',
    },
  });
</script>

