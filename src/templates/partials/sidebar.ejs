<%
  var _pageTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : '';
  var _page    = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : (_pageTitle ? String(_pageTitle).toLowerCase() : 'home');
  var _isHome  = (_page === 'home');
  var _active  = _isHome ? 'home' : _page;

  var _navLinks = [
    { key: 'home', href: rootPrefix,                    label: 'Home',     icon: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10' },
    { key: 'docs', href: rootPrefix + 'docs/',          label: 'Docs',     icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8' },
    { key: 'blog', href: rootPrefix + 'blog/',          label: 'Blog',     icon: 'M12 20h9 M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z' },
  ];
%>

<aside class="site-sidebar">
  <div class="site-sidebar-header">
    <a href="<%= rootPrefix %>" class="site-sidebar-logo">
      <img src="<%= rootPrefix %>public/assets/icon.png" alt="" width="22" height="22">
      AirLink
    </a>
  </div>

  <!-- Universal nav links -->
  <nav class="site-sidebar-nav" id="site-sidebar-nav">
    <% _navLinks.forEach(function(link) { %>
      <a href="<%= link.href %>" class="site-nav-link<%= link.key === _active ? ' active' : '' %>">
        <svg width="15" height="15" fill="none" stroke="currentColor"
          stroke-width="<%= link.key === _active ? '2.2' : '1.7' %>" viewBox="0 0 24 24">
          <path d="<%= link.icon %>"/>
        </svg>
        <span><%= link.label %></span>
      </a>
    <% }); %>

    <div class="site-sidebar-divider"></div>

    <!-- Theme toggle -->
    <button data-theme-toggle class="site-nav-link site-nav-btn">
      <svg class="theme-icon-sun" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" style="display:none;"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      <svg class="theme-icon-moon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span>Theme</span>
    </button>

    <!-- Sound toggle -->
    <button id="mute-btn" class="site-nav-link site-nav-btn">
      <svg class="mute-state-on" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
      <svg class="mute-state-off" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
      <span>Sound</span>
    </button>
  </nav>

  <!-- Page-specific section links (passed as sidebarLinks array) -->
  <% if (typeof sidebarLinks !== 'undefined' && sidebarLinks && sidebarLinks.length) { %>
  <div class="site-sidebar-divider"></div>
  <nav class="site-sidebar-section">
    <% if (typeof sidebarSectionLabel !== 'undefined' && sidebarSectionLabel) { %>
      <div class="site-sidebar-section-label"><%= sidebarSectionLabel %></div>
    <% } %>
    <% sidebarLinks.forEach(function(link, i) { %>
      <a href="<%= link.href %>" class="site-section-link<%= link.active ? ' active' : '' %>" data-search-text="<%= (link.label || '').toLowerCase() %>" data-animate="fade" data-animate-delay="<%= Math.min(i * 40, 400) %>">
        <%= link.label %>
      </a>
    <% }); %>
  </nav>
  <% } %>

  <!-- Credit line at bottom -->
  <div class="site-sidebar-footer">
    <span>MIT</span>
    <span class="credit-dot">·</span>
    <a href="https://github.com/thavanish" target="_blank" rel="noopener">Thavanish</a>
    <span class="credit-dot">·</span>
    <a href="https://github.com/<%= (typeof site !== 'undefined' && site.githubOrg) ? site.githubOrg : 'airlinklabs' %>" target="_blank" rel="noopener">AirlinkLabs</a>
  </div>
</aside>
