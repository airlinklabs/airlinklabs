<% var _page = typeof currentPage !== 'undefined' ? currentPage : 'home'; %>
<aside class="site-sidebar">
  <div class="site-sidebar-header">
    <a href="<%= rootPrefix %>" class="site-sidebar-logo">
      <img src="<%= rootPrefix %>public/assets/icon.png" alt="" width="24" height="24">
      <span>AirLink</span>
    </a>
  </div>
  <nav class="site-sidebar-nav" aria-label="Primary navigation">
    <a href="<%= rootPrefix %>" class="site-nav-link<%= _page === 'home' ? ' active' : '' %>"<%= _page === 'home' ? ' aria-current="page"' : '' %>>
      <iconify-icon icon="lucide:home" width="16" height="16"></iconify-icon>
      <span>Home</span>
    </a>
    <a href="<%= rootPrefix %>docs/" class="site-nav-link<%= _page === 'docs' ? ' active' : '' %>"<%= _page === 'docs' ? ' aria-current="page"' : '' %>>
      <iconify-icon icon="lucide:book-open" width="16" height="16"></iconify-icon>
      <span>Docs</span>
    </a>
    <a href="<%= rootPrefix %>blog/" class="site-nav-link<%= _page === 'blog' ? ' active' : '' %>"<%= _page === 'blog' ? ' aria-current="page"' : '' %>>
      <iconify-icon icon="lucide:newspaper" width="16" height="16"></iconify-icon>
      <span>Blog</span>
    </a>
  </nav>
  <% if (typeof docHeadings !== 'undefined' && docHeadings && docHeadings.length) { %>
  <div class="site-sidebar-context">
    <p>On this page</p>
    <nav>
      <% docHeadings.forEach(function(h) { %>
      <a href="#<%= h.id %>" class="site-section-link toc-h<%= h.level %>" data-toc-id="<%= h.id %>">
        <span><%= h.text %></span>
        <iconify-icon icon="lucide:chevron-right" width="12" height="12"></iconify-icon>
      </a>
      <% }); %>
    </nav>
  </div>
  <% } else if (typeof sidebarLinks !== 'undefined' && sidebarLinks && sidebarLinks.length) { var _lastSection = ''; %>
  <div class="site-sidebar-context">
    <p><%= sidebarSectionLabel || 'In this section' %></p>
    <nav>
      <% sidebarLinks.forEach(function(link) { if (link.section && link.section !== _lastSection) { _lastSection = link.section; %>
      <p class="site-sidebar-subsection"><%= link.section %></p>
      <% } %>
      <a href="<%= link.href %>" class="site-section-link<%= link.active ? ' active' : '' %>" data-search-text="<%= (link.label || '').toLowerCase() %>"<%= link.href.startsWith('#') ? ' data-toc-id="' + link.href.slice(1) + '"' : '' %>>
        <span><%= link.label %></span>
        <iconify-icon icon="lucide:chevron-right" width="12" height="12"></iconify-icon>
      </a>
      <% }); %>
    </nav>
  </div>
  <% } %>
  <div class="site-sidebar-footer">
    <div class="sidebar-social-row">
      <a href="https://github.com/AirlinkLabs" target="_blank" rel="noopener" aria-label="GitHub">
        <iconify-icon icon="lucide:github" width="16" height="16"></iconify-icon>
      </a>
      <a href="https://ko-fi.com/airlinklabs" target="_blank" rel="noopener" aria-label="Ko-fi">
        <iconify-icon icon="lucide:coffee" width="16" height="16"></iconify-icon>
      </a>
      <a href="https://discord.gg/CmrDB2tRaN" target="_blank" rel="noopener" aria-label="Discord">
        <iconify-icon icon="lucide:message-circle" width="16" height="16"></iconify-icon>
      </a>
    </div>
  </div>
</aside>
