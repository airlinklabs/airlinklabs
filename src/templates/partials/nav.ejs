<%
var _page    = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : ((pageTitle) ? String(pageTitle).toLowerCase() : 'home');
var _isHome  = (_page === 'home');
var _active  = _isHome ? 'home' : _page;

var _links = [
  { key: 'home',     href: rootPrefix,                    label: 'Home',     icon: 'lucide:home' },
  { key: 'docs',     href: rootPrefix + 'docs/',          label: 'Docs',     icon: 'lucide:book-open' },
  { key: 'blog',     href: rootPrefix + 'blog/',          label: 'Blog',     icon: 'lucide:newspaper' },
];
%>

<!-- Mobile: frosted glass pill (hidden on desktop via CSS) -->
<nav id="mobile-bar" aria-label="Site navigation">
  <% _links.forEach(function (link) { var on = link.key === _active; %>
  <a href="<%= link.href %>" class="mob-item <%= on ? 'mob-item--active' : '' %>"<%= on ? ' aria-current="page"' : '' %>>
    <iconify-icon icon="<%= link.icon %>" width="18" height="18"></iconify-icon>
    <span><%= link.label %></span>
  </a>
  <% }); %>
</nav>

<!-- Redirect confirmation modal — shared across all pages -->
<div id="redirect-overlay" role="dialog" aria-modal="true" aria-labelledby="redirect-heading">
  <div id="redirect-modal">
    <div id="redirect-domain"></div>
    <h4 id="redirect-heading">Leaving this site</h4>
    <p>You're about to open an external link. Continue?</p>
    <div class="redirect-actions">
      <button id="redirect-cancel" type="button">Cancel</button>
      <button id="redirect-confirm" type="button">Continue</button>
    </div>
  </div>
</div>

<!-- Construction warning popup — first visit only, gated by package.json -->
<% if (underConstruction && underConstruction.enabled) { %>
<div id="construction-overlay" role="dialog" aria-modal="true" aria-labelledby="construction-heading">
  <div id="construction-modal">
    <h4 id="construction-heading"><%= underConstruction.badge || 'Under construction' %></h4>
    <p><%= underConstruction.message || 'This site is still being built. Some pages may be incomplete or inaccurate.' %></p>
    <div class="redirect-actions">
      <button id="construction-ok" type="button">Got it</button>
    </div>
  </div>
</div>
<% } %>

<!-- License modal -->
<div id="license-overlay" role="dialog" aria-modal="true" aria-labelledby="license-heading">
  <div id="license-modal">
    <div id="license-header">
      <h4 id="license-heading">Licenses</h4>
      <button id="license-close" type="button" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="license-body">
      <p class="license-section-label">Organization repositories</p>
      <div id="license-repos"></div>
      <p class="license-section-label">Dependencies</p>
      <div id="license-npm"></div>
      <p class="license-section-label">CDN</p>
      <div id="license-cdn"></div>
    </div>
  </div>
</div>
