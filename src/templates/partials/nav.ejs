<%
var _page    = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : ((pageTitle) ? String(pageTitle).toLowerCase() : 'home');
var _isHome  = (_page === 'home');
var _active  = _isHome ? 'home' : _page;

var _links = [
  { key: 'home',     href: rootPrefix,                    label: 'Home',     icon: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' },
  { key: 'docs',     href: rootPrefix + 'docs/',          label: 'Docs',     icon: '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>' },
  { key: 'blog',     href: rootPrefix + 'blog/',          label: 'Blog',     icon: '<path d="M4 19.5V4.75A1.75 1.75 0 0 1 5.75 3h12.5A1.75 1.75 0 0 1 20 4.75v14.75l-4-2.5-4 2.5-4-2.5-4 2.5z"/>' },
];
%>

<!-- Mobile: frosted glass pill (hidden on desktop via CSS) -->
<nav id="mobile-bar" aria-label="Site navigation">
  <% _links.forEach(function (link) { var on = link.key === _active; %>
  <a href="<%= link.href %>" class="mob-item <%= on ? 'mob-item--active' : '' %>"<%= on ? ' aria-current="page"' : '' %>>
    <svg width="18" height="18" fill="none" stroke="currentColor"
      stroke-width="<%= on ? '2.2' : '1.7' %>" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
      <%- link.icon %>
    </svg>
    <span><%= link.label %></span>
  </a>
  <% }); %>


</nav>

<!-- Redirect confirmation modal — shared across all pages -->
<div id="redirect-overlay" role="dialog" aria-modal="true" aria-labelledby="redirect-heading">
  <div id="redirect-modal">
    <div id="redirect-domain"></div>
    <h4 id="redirect-heading">Leaving this site</h4>
    <p>You're about to open an external link. Continue?</p>
    <div class="redirect-actions">
      <button id="redirect-cancel" type="button">Cancel</button>
      <button id="redirect-confirm" type="button">Continue</button>
    </div>
  </div>
</div>
