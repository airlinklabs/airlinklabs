<script>
(function() {
  var overlay   = document.getElementById('feat-overlay');
  var modal     = document.getElementById('feat-modal');
  var iconEl    = document.getElementById('feat-modal-icon');
  var titleEl   = document.getElementById('feat-modal-title');
  var descEl    = document.getElementById('feat-modal-desc');
  var longEl    = document.getElementById('feat-modal-long');
  var closeBtn  = document.getElementById('feat-modal-close');
  var gifImg    = document.getElementById('feat-modal-gif');
  var gifPh     = document.getElementById('feat-modal-gif-ph');
  var gifLabel  = document.getElementById('feat-modal-gif-label');
  var EASE      = 'cubic-bezier(0.4,0,0.2,1)';

  var iconMap = {};
  <% features.forEach(function(f) { %>iconMap['<%= f.id %>'] = '<%- featureIcon(f.icon).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\n/g,'') %>';<% }) %>

  var _featPrevFocus = null;

  function trapFocus(overlayEl, modalEl) {
    var focusable = modalEl.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    var first = focusable[0];
    var last = focusable[focusable.length - 1];
    function handler(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }
    overlayEl._trapHandler = handler;
    overlayEl.addEventListener('keydown', handler);
  }

  function openModal(card) {
    var id = card.dataset.featureId || '';
    iconEl.innerHTML    = iconMap[id] || '';
    titleEl.textContent = card.dataset.featureTitle || '';
    descEl.textContent  = card.dataset.featureDesc  || '';
    longEl.textContent  = card.dataset.featureLong  || '';

    // Load theme-aware GIF
    var theme  = document.documentElement.className === 'light' ? 'light' : 'dark';
    var gifSrc = 'public/assets/features/' + id + '/' + id + '-' + theme + '.png';
    gifImg.style.display = 'none';
    gifImg.style.opacity = '0';
    gifPh.style.display  = 'flex';
    if (gifLabel) gifLabel.textContent = id + '-' + theme + '.png';
    gifImg.onerror = function() { gifImg.style.display = 'none'; gifPh.style.display = 'flex'; };
    gifImg.onload  = function() {
      gifImg.style.display    = 'block';
      gifPh.style.display     = 'none';
      gifImg.style.transition = 'opacity 280ms cubic-bezier(0.4,0,0.2,1)';
      void gifImg.offsetHeight;
      gifImg.style.opacity    = '1';
    };
    gifImg.src = gifSrc;

    _featPrevFocus = document.activeElement;
    overlay.classList.add('overlay--open');
    trapFocus(overlay, modal);
    var firstFocusable = modal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (firstFocusable) firstFocusable.focus();
    if (typeof sounds !== 'undefined') sounds.play('modalOpen');
  }

  function closeModal() {
    overlay.classList.remove('overlay--open');
    if (overlay._trapHandler) { overlay.removeEventListener('keydown', overlay._trapHandler); overlay._trapHandler = null; }
    if (_featPrevFocus) { _featPrevFocus.focus(); _featPrevFocus = null; }
    if (typeof sounds !== 'undefined') sounds.play('modalClose');
  }

  document.querySelectorAll('[data-feature-id]').forEach(function(card) {
    card.addEventListener('click', function() { openModal(card); });
  });
  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeModal(); });
})();
</script>

<script>
(function() {
  var dotsEl   = document.getElementById('wiz-dots');
  var summaryEl = document.getElementById('wiz-summary');
  var labelEl  = document.getElementById('wiz-step-label');
  var titleEl  = document.getElementById('wiz-step-title');
  var bodyEl   = document.getElementById('wiz-step-body');
  var backBtn  = document.getElementById('wiz-back');
  var nextBtn  = document.getElementById('wiz-next');

  if (!dotsEl || !bodyEl) return;

  // Stored answers
  var ans = {
    mode:       'both',   // both | panel | daemon
    name:       'Airlink',
    port:       '3000',
    email:      '',
    user:       'admin',
    pass:       '',
    panelAddr:  '127.0.0.1',
    daemonPort: '3002',
    daemonKey:  '',
    addons:     [],       // ['modrinth', 'parachute']
  };

  // Step definitions — filtered dynamically based on mode
  function getSteps() {
    var steps = [ { id: 'mode' } ];
    if (ans.mode !== 'daemon') {
      steps.push({ id: 'panel-setup' });
      steps.push({ id: 'admin' });
    }
    if (ans.mode !== 'panel') {
      steps.push({ id: 'daemon-setup' });
    }
    if (ans.mode !== 'daemon') {
      steps.push({ id: 'addons' });
    }
    steps.push({ id: 'result' });
    return steps;
  }

  var isAnimating = false;

  function animateStepBody(direction, renderFn) {
    // direction: 1 = forward (slide left), -1 = back (slide right)
    if (isAnimating) {
      bodyEl.innerHTML = renderFn();
      return;
    }
    isAnimating = true;
    var EASE = 'cubic-bezier(0.4,0,0.2,1)';
    var outX = direction > 0 ? '-18px' : '18px';
    var inX  = direction > 0 ?  '18px' : '-18px';

    // Slide current content out
    bodyEl.style.transition = 'opacity 140ms ' + EASE + ', transform 140ms ' + EASE;
    bodyEl.style.opacity    = '0';
    bodyEl.style.transform  = 'translateX(' + outX + ')';

    setTimeout(function() {
      bodyEl.innerHTML        = renderFn();
      bodyEl.style.transition = 'none';
      bodyEl.style.opacity    = '0';
      bodyEl.style.transform  = 'translateX(' + inX + ')';
      void bodyEl.offsetHeight;
      bodyEl.style.transition = 'opacity 200ms ' + EASE + ', transform 200ms ' + EASE;
      bodyEl.style.opacity    = '1';
      bodyEl.style.transform  = 'translateX(0)';

      setTimeout(function() {
        bodyEl.style.transition = '';
        isAnimating = false;
        var firstInput = bodyEl.querySelector('input');
        if (firstInput) firstInput.focus();
      }, 210);
    }, 150);
  }

  function animateHeaderChange(labelText, titleText) {
    var EASE = 'cubic-bezier(0.4,0,0.2,1)';
    labelEl.style.transition = 'opacity 100ms ' + EASE;
    titleEl.style.transition = 'opacity 100ms ' + EASE;
    labelEl.style.opacity = '0';
    titleEl.style.opacity = '0';
    setTimeout(function() {
      labelEl.textContent = labelText;
      titleEl.textContent = titleText;
      labelEl.style.opacity = '1';
      titleEl.style.opacity = '1';
    }, 110);
  }

  function animateSummaryIn() {
    var EASE = 'cubic-bezier(0.4,0,0.2,1)';
    summaryEl.style.opacity   = '0';
    summaryEl.style.transform = 'translateY(-4px)';
    summaryEl.style.display   = 'block';
    void summaryEl.offsetHeight;
    summaryEl.style.transition = 'opacity 200ms ' + EASE + ', transform 200ms ' + EASE;
    summaryEl.style.opacity    = '1';
    summaryEl.style.transform  = 'translateY(0)';
  }

  function inputStyle() {
    return 'width:100%;box-sizing:border-box;background:var(--color-bg-input);border:1px solid var(--color-border-input);border-radius:8px;padding:10px 12px;font-size:13px;font-family:var(--font-mono);color:var(--color-text-1);outline:none;';
  }

  function textInput(id, type, val, ph) {
    return '<input id="' + id + '" type="' + type + '" value="' + val + '" placeholder="' + ph + '" style="' + inputStyle() + '" onfocus="this.style.borderColor=\'var(--color-text-4)\'" onblur="this.style.borderColor=\'var(--color-border-input)\'">'; 
  }

  function fieldGroup(fields) {
    // fields: [{label, input}] — renders as a clean vertical stack, no margin hacks
    var html = '<div style="display:flex;flex-direction:column;gap:14px;">';
    fields.forEach(function(f) {
      html += '<div>'
        + '<p style="font-size:10px;font-family:var(--font-mono);color:var(--color-text-3);text-transform:uppercase;letter-spacing:0.08em;margin:0 0 6px;">' + f.label + '</p>'
        + f.input
        + '</div>';
    });
    html += '</div>';
    return html;
  }

  function renderStep(stepId) {
    var html = '';

    if (stepId === 'mode') {
      html += '<p style="font-size:13px;color:var(--color-text-2);line-height:1.6;margin:0 0 14px;">This script installs Node.js, Docker, the panel, and optionally the daemon. All on your Linux server. No cloud required.</p>';
      html += '<div style="display:flex;flex-direction:column;gap:8px;">';
      var opts = [
        { val:'both',   label:'Panel + Daemon', desc:'The full package. Panel UI and the daemon that actually runs your game containers.' },
        { val:'panel',  label:'Panel only',      desc:'Just the web panel. You can add the daemon later when you are ready.'        },
        { val:'daemon', label:'Daemon only',      desc:'Install the daemon on a machine that already has a panel talking to it.'        },
      ];
      opts.forEach(function(o) {
        var active = ans.mode === o.val;
        html += '<div style="display:flex;align-items:flex-start;gap:12px;padding:11px 14px;border:1px solid '
          + (active ? 'var(--color-border-input)' : 'var(--color-border)')
          + ';border-radius:10px;background:'
          + (active ? 'var(--color-bg-hover)' : 'var(--color-bg)')
          + ';cursor:pointer;user-select:none;" onclick="wizModeChange(\'' + o.val + '\')">'
          + '<div style="width:16px;height:16px;border-radius:50%;border:1.5px solid '
          + (active ? 'var(--color-text-1)' : 'var(--color-text-4)')
          + ';display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;background:'
          + (active ? 'var(--color-text-1)' : 'transparent') + ';">'
          + (active ? '<span style="width:6px;height:6px;border-radius:50%;background:var(--color-bg);display:block;"></span>' : '')
          + '</div>'
          + '<div><p style="font-size:13px;font-weight:600;color:var(--color-text-1);margin:0 0 2px;letter-spacing:-0.01em;">' + o.label + '</p>'
          + '<p style="font-size:11px;color:var(--color-text-3);margin:0;line-height:1.5;">' + o.desc + '</p></div>'
          + '</div>';
      });
      html += '</div>';

    } else if (stepId === 'panel-setup') {
      html += fieldGroup([
        { label: 'Panel name', input: textInput('wiz-name', 'text', ans.name, 'Airlink') },
        { label: 'Panel port', input: textInput('wiz-port', 'number', ans.port, '3000') },
      ]);

    } else if (stepId === 'admin') {
      html += '<p style="font-size:12px;color:var(--color-text-3);line-height:1.6;margin:0 0 14px;">First account gets admin. After setup, new signups go through the normal registration flow.</p>';
      html += fieldGroup([
        { label: 'Email',    input: textInput('wiz-email', 'email',    ans.email, 'admin@example.com') },
        { label: 'Username', input: textInput('wiz-user',  'text',     ans.user,  'admin') },
        { label: 'Password', input: textInput('wiz-pass',  'password', ans.pass,  'min 8 chars · one letter · one number') },
      ]);

    } else if (stepId === 'daemon-setup') {
      html += '<p style="font-size:12px;color:var(--color-text-3);line-height:1.6;margin:0 0 14px;">Grab the auth key from the panel after install. Go to Nodes, create a node, copy the key.</p>';
      html += fieldGroup([
        { label: 'Panel address',  input: textInput('wiz-panel-addr',  'text',   ans.panelAddr,  '127.0.0.1 or your panel domain') },
        { label: 'Daemon port',    input: textInput('wiz-daemon-port', 'number', ans.daemonPort, '3002') },
        { label: 'Daemon auth key',input: textInput('wiz-daemon-key',  'text',   ans.daemonKey,  'from panel → Nodes') },
      ]);

    } else if (stepId === 'addons') {
      html += '<p style="font-size:12px;color:var(--color-text-3);line-height:1.6;margin:0 0 14px;">Extras. These get installed after the main setup finishes. Skip if you want to keep it simple.</p>';
      html += '<div style="display:flex;flex-direction:column;gap:8px;">';
      var addonsOpts = [
        { id:'modrinth',  name:'Modrinth Store', desc:'Browse and install Minecraft mods from Modrinth inside the panel.' },
        { id:'parachute', name:'Parachute',       desc:'Google Drive backups for your servers via OAuth.'                  },
      ];
      addonsOpts.forEach(function(a) {
        var on = ans.addons.indexOf(a.id) !== -1;
        html += '<div style="display:flex;align-items:flex-start;gap:12px;padding:11px 14px;border:1px solid '
          + (on ? 'var(--color-border-input)' : 'var(--color-border)')
          + ';border-radius:10px;background:'
          + (on ? 'var(--color-bg-hover)' : 'var(--color-bg)')
          + ';cursor:pointer;user-select:none;" onclick="wizToggleAddon(\'' + a.id + '\')">'
          + '<div style="width:14px;height:14px;border-radius:3px;border:1.5px solid '
          + (on ? 'var(--color-text-1)' : 'var(--color-text-4)')
          + ';display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;background:'
          + (on ? 'var(--color-text-1)' : 'transparent') + ';">'
          + (on ? '<svg width="8" height="8" fill="none" stroke="var(--color-bg)" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>' : '')
          + '</div>'
          + '<div><p style="font-size:13px;font-weight:600;color:var(--color-text-1);margin:0 0 2px;letter-spacing:-0.01em;">' + a.name + '</p>'
          + '<p style="font-size:11px;color:var(--color-text-3);margin:0;line-height:1.5;">' + a.desc + '</p></div>'
          + '</div>';
      });
      html += '</div>';

    } else if (stepId === 'result') {
      var cmd = buildCommand();
      html += '<p style="font-size:12px;color:var(--color-text-3);margin:0 0 12px;">Copy this, paste it on your server as root. Done.</p>';
      html += '<div class="code-block" style="position:relative;background:var(--color-bg-input);border:1px solid var(--color-border);border-radius:9px;padding:14px 16px;">'
        + '<code id="inst-cmd" style="font-size:11px;color:var(--color-text-1);font-family:var(--font-mono);line-height:1.7;display:block;white-space:pre-wrap;word-break:break-all;padding-right:52px;">' + cmd + '</code>'
        + '<button class="copy-btn" style="position:absolute;top:10px;right:10px;font-size:10px;font-family:var(--font-mono);color:var(--color-text-3);background:var(--color-bg-2);border:1px solid var(--color-border);padding:5px 10px;border-radius:6px;display:flex;align-items:center;gap:4px;cursor:pointer;">'
        + '<svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>'
        + 'Copy</button>'
        + '</div>';
    }

    return html;
  }

  function collectStep(stepId) {
    if (stepId === 'panel-setup') {
      var n = document.getElementById('wiz-name'); if (n) ans.name = n.value.trim() || 'Airlink';
      var p = document.getElementById('wiz-port'); if (p) ans.port = p.value.trim() || '3000';
    } else if (stepId === 'admin') {
      var e = document.getElementById('wiz-email'); if (e) ans.email = e.value.trim();
      var u = document.getElementById('wiz-user');  if (u) ans.user  = u.value.trim() || 'admin';
      var pw = document.getElementById('wiz-pass'); if (pw) ans.pass = pw.value.trim();
    } else if (stepId === 'daemon-setup') {
      var a = document.getElementById('wiz-panel-addr');  if (a)  ans.panelAddr  = a.value.trim()  || '127.0.0.1';
      var dp = document.getElementById('wiz-daemon-port'); if (dp) ans.daemonPort = dp.value.trim() || '3002';
      var dk = document.getElementById('wiz-daemon-key');  if (dk) ans.daemonKey  = dk.value.trim();
    }
  }

  var stepTitles = {
    'mode':         ['Step 1',    'What are we installing today?'],
    'panel-setup':  ['Panel',     'Name your creation'],
    'admin':        ['Panel',     'Admin account (first one gets the crown)'],
    'daemon-setup': ['Daemon',    'How does it talk to the panel?'],
    'addons':       ['Addons',    'Extra features? Yes please.'],
    'result':       ['Install',   'Your one-liner is ready'],
  };

  function summaryLine(label, val) {
    return '<span style="font-size:11px;font-family:var(--font-mono);color:var(--color-text-3);">' + label + '</span>'
         + '<span style="font-size:11px;font-family:var(--font-mono);color:var(--color-text-1);margin-left:8px;">' + (val || '—') + '</span>';
  }

  function renderSummary(steps, upToIndex) {
    if (upToIndex <= 0) { summaryEl.style.display = 'none'; return; }
    var lines = [];
    for (var i = 0; i < upToIndex; i++) {
      var sid = steps[i].id;
      if (sid === 'mode')         lines.push(summaryLine('Install', ans.mode === 'both' ? 'Panel + Daemon' : ans.mode === 'panel' ? 'Panel only' : 'Daemon only'));
      if (sid === 'panel-setup')  lines.push(summaryLine('Panel', ans.name + '  :' + ans.port));
      if (sid === 'admin')        lines.push(summaryLine('Admin', ans.email || ans.user));
      if (sid === 'daemon-setup') lines.push(summaryLine('Daemon', ans.panelAddr + '  :' + ans.daemonPort));
      if (sid === 'addons')       lines.push(summaryLine('Addons', ans.addons.length ? ans.addons.join(', ') : 'none'));
    }
    summaryEl.innerHTML = lines.join('<span style="color:var(--color-text-4);padding:0 10px;">·</span>');
    summaryEl.style.display = 'block';
  }

  function renderDots(steps, current) {
    dotsEl.innerHTML = '';
    steps.forEach(function(s, i) {
      var dot = document.createElement('span');
      dot.style.cssText = 'width:' + (i === current ? '20px' : '6px') + ';height:6px;border-radius:999px;background:' + (i <= current ? 'var(--color-text-1)' : 'var(--color-border-input)') + ';transition:all 200ms;display:inline-block;';
      dotsEl.appendChild(dot);
    });
  }

  function buildCommand() {
    var url  = 'https://raw.githubusercontent.com/airlinklabs/panel/refs/heads/main/installer.sh';
    var args = [];
    if (ans.mode === 'panel')  args.push('--panel-only');
    if (ans.mode === 'daemon') args.push('--daemon-only');
    if (ans.mode !== 'daemon') {
      if (ans.name  && ans.name  !== 'Airlink') args.push('--name "' + ans.name + '"');
      if (ans.port  && ans.port  !== '3000')    args.push('--port ' + ans.port);
      if (ans.email)                             args.push('--admin-email "' + ans.email + '"');
      if (ans.user  && ans.user  !== 'admin')    args.push('--admin-user "' + ans.user + '"');
      if (ans.pass)                              args.push('--admin-pass "' + ans.pass + '"');
    }
    if (ans.mode !== 'panel') {
      if (ans.panelAddr  && ans.panelAddr  !== '127.0.0.1') args.push('--panel-addr "' + ans.panelAddr + '"');
      if (ans.daemonPort && ans.daemonPort !== '3002')       args.push('--daemon-port ' + ans.daemonPort);
      if (ans.daemonKey)                                     args.push('--daemon-key "' + ans.daemonKey + '"');
    }
    if (ans.addons.length) args.push('--addons "' + ans.addons.join(',') + '"');
    var cmd = 'curl -sL ' + url + ' | bash -s --';
    if (args.length) cmd += ' \\\n  ' + args.join(' \\\n  ');
    return cmd;
  }

  var currentStep = 0;
  var stepDirection = 1; // 1 = forward, -1 = back

  function render() {
    var steps  = getSteps();
    var stepId = steps[currentStep].id;
    var meta   = stepTitles[stepId];

    renderDots(steps, currentStep);

    // Show summary bar from step 1 onward, but not on the result step
    if (currentStep > 0 && stepId !== 'result') {
      renderSummary(steps, currentStep);
      if (summaryEl.style.display === 'none' || !summaryEl.style.display) {
        animateSummaryIn();
      }
    } else {
      summaryEl.style.display = 'none';
    }

    animateHeaderChange(meta[0], meta[1]);
    animateStepBody(stepDirection, function() { return renderStep(stepId); });

    var isLast = currentStep === steps.length - 1;
    backBtn.style.display = currentStep > 0 ? '' : 'none';
    // Last step is result — hide Next, user copies from the code block
    nextBtn.style.display = isLast ? 'none' : '';
    if (!isLast) nextBtn.textContent = currentStep === steps.length - 2 ? 'Get command →' : 'Next →';


  }

  window.wizModeChange = function(val) {
    ans.mode = val;
    animateStepBody(0, function() { return renderStep('mode'); });
    if (typeof sounds !== 'undefined') sounds.play('select');
  };

  window.wizToggleAddon = function(id) {
    var idx = ans.addons.indexOf(id);
    if (idx === -1) ans.addons.push(id); else ans.addons.splice(idx, 1);
    animateStepBody(0, function() { return renderStep('addons'); });
    if (typeof sounds !== 'undefined') sounds.play('toggle');
  };

  nextBtn.addEventListener('click', function() {
    var steps  = getSteps();
    var stepId = steps[currentStep].id;
    collectStep(stepId);

    if (currentStep < steps.length - 1) {
      var isResultStep = steps[currentStep + 1].id === 'result';
      stepDirection = 1;
      currentStep++;
      render();
      if (typeof sounds !== 'undefined') sounds.play(isResultStep ? 'wizResult' : 'wizNext');
    }
  });

  backBtn.addEventListener('click', function() {
    var steps  = getSteps();
    collectStep(steps[currentStep].id);
    if (currentStep > 0) {
      stepDirection = -1;
      currentStep--;
      render();
      if (typeof sounds !== 'undefined') sounds.play('wizBack');
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && document.getElementById('wiz-card') && bodyEl.contains(document.activeElement)) {
      e.preventDefault();
      nextBtn.click();
    }
  });

  render();
})();
</script>

<script>
// ── Hero window ───────────────────────────────────────────────────────────────
// Handles: traffic lights (close/minimize/maximize), tray strip, fullscreen overlay,
// theme-aware image switching, and the feature image rotation.
(function() {
  // All feature images — id and title
  var HERO_IMAGES = [
    <% features.forEach(function(f, i) { %>{ id: '<%= f.id %>', title: '<%= f.title %>' }<%= i < features.length - 1 ? ',' : '' %>
    <% }) %>
  ];

  var currentIndex = 0;
  var isMinimized  = false;

  var win       = document.getElementById('hero-window');
  var imgArea   = document.getElementById('hero-img-area');
  var tray      = document.getElementById('hero-tray');
  var titleEl   = document.getElementById('hero-win-title');
  var darkImg   = document.getElementById('hero-img-dark');
  var lightImg  = document.getElementById('hero-img-light');
  var phEl      = document.getElementById('hero-img-ph');
  var phLabel   = document.getElementById('hero-img-ph-label');

  var btnClose    = document.getElementById('hw-close');
  var btnMinimize = document.getElementById('hw-minimize');
  var btnMaximize = document.getElementById('hw-maximize');

  var fsOverlay = document.getElementById('hero-fullscreen');
  var fsInner   = document.getElementById('hero-fs-inner');
  var fsDark    = document.getElementById('hero-fs-img-dark');
  var fsLight   = document.getElementById('hero-fs-img-light');
  var fsPh      = document.getElementById('hero-fs-ph');
  var fsTitleEl = document.getElementById('hero-fs-title');
  var fsBtnClose    = document.getElementById('hw-fs-close');
  var fsBtnMinimize = document.getElementById('hw-fs-minimize');
  var fsBtnPrev     = document.getElementById('hw-fs-prev');
  var fsBtnNext     = document.getElementById('hw-fs-next');

  var EASE = 'cubic-bezier(0.4,0,0.2,1)';

  function isDark() { return document.documentElement.className !== 'light'; }

  function imgPath(id, theme) {
    return 'public/assets/features/' + id + '/' + id + '-' + theme + '.png';
  }

  function applyThemeImage(dImg, lImg, phDiv, phLbl, id) {
    var theme     = isDark() ? 'dark' : 'light';
    var altTheme  = isDark() ? 'light' : 'dark';
    var wantImg   = isDark() ? dImg : lImg;
    var otherImg  = isDark() ? lImg : dImg;
    var label     = id + '-' + theme + '.png';

    if (wantImg) {
      wantImg.src   = imgPath(id, theme);
      wantImg.style.display = 'block';
      wantImg.style.opacity = '0';
      wantImg.onload = function() {
        wantImg.style.opacity = '1';
        if (phDiv) phDiv.style.display = 'none';
      };
      wantImg.onerror = function() {
        wantImg.style.display = 'none';
        if (otherImg) {
          otherImg.src = imgPath(id, altTheme);
          otherImg.style.display = 'block';
          otherImg.style.opacity = '0';
          otherImg.onload = function() { otherImg.style.opacity = '1'; if (phDiv) phDiv.style.display = 'none'; };
          otherImg.onerror = function() { otherImg.style.display = 'none'; if (phDiv) phDiv.style.display = 'flex'; };
        } else {
          if (phDiv) phDiv.style.display = 'flex';
        }
      };
    }
    if (otherImg) otherImg.style.display = 'none';
    if (phLbl)    phLbl.textContent = label;
    if (phDiv)    phDiv.style.display = 'flex';
  }

  function loadImage(index) {
    var entry = HERO_IMAGES[index];
    if (!entry) return;
    if (titleEl) titleEl.textContent = entry.title;
    applyThemeImage(darkImg, lightImg, phEl, phLabel, entry.id);
  }

  function loadFsImage(index) {
    var entry = HERO_IMAGES[index];
    if (!entry) return;
    if (fsTitleEl) fsTitleEl.textContent = entry.title;
    applyThemeImage(fsDark, fsLight, fsPh, null, entry.id);
  }

  // Traffic light hover icons (show icon on hover, hide on mouseout)
  var ICONS = {
    close:    '<svg width="6" height="6" viewBox="0 0 10 10" fill="none" stroke="rgba(0,0,0,0.5)" stroke-width="1.8"><line x1="2" y1="2" x2="8" y2="8"/><line x1="8" y1="2" x2="2" y2="8"/></svg>',
    minimize: '<svg width="6" height="6" viewBox="0 0 10 10" fill="none" stroke="rgba(0,0,0,0.5)" stroke-width="1.8"><line x1="2" y1="5" x2="8" y2="5"/></svg>',
    maximize: '<svg width="6" height="6" viewBox="0 0 10 10" fill="none" stroke="rgba(0,0,0,0.5)" stroke-width="1.8"><polyline points="6,2 8,2 8,4"/><polyline points="4,8 2,8 2,6"/><line x1="8" y1="2" x2="5.5" y2="4.5"/><line x1="4.5" y1="5.5" x2="2" y2="8"/></svg>',
    restore:  '<svg width="6" height="6" viewBox="0 0 10 10" fill="none" stroke="rgba(0,0,0,0.5)" stroke-width="1.8"><rect x="1" y="3" width="6" height="6" rx="1"/><path d="M3 3V2a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H8"/></svg>',
  };

  window.hwBtnHover = function(btn, type, on) {
    btn.innerHTML = on ? ICONS[type] : '';
  };

  window.hwFsBtnHover = function(btn, type, on) {
    btn.innerHTML = on ? ICONS[type === 'minimize' ? 'restore' : type] : '';
  };

  function buildTray() {
    tray.innerHTML = '';
    tray.style.cssText += ';-webkit-overflow-scrolling:touch;';
    HERO_IMAGES.forEach(function(entry, i) {
      var thumb = document.createElement('button');
      thumb.title = entry.title;
      thumb.setAttribute('aria-label', entry.title);
      thumb.style.cssText = [
        'width:90px;height:58px;flex-shrink:0;border-radius:7px;overflow:hidden;',
        'border:' + (i === currentIndex ? '2px solid var(--color-text-1)' : '1.5px solid var(--color-border)') + ';',
        'background:var(--color-bg-3);cursor:pointer;padding:0;',
        'transition:border-color 140ms,transform 140ms;position:relative;',
      ].join('');
      var tImg = document.createElement('img');
      var theme = isDark() ? 'dark' : 'light';
      tImg.src = imgPath(entry.id, theme);
      tImg.alt = entry.title;
      tImg.loading = 'lazy';
      tImg.style.cssText = 'width:100%;height:100%;object-fit:cover;object-position:top;display:block;';
      tImg.onerror = function() {
        var alt = isDark() ? 'light' : 'dark';
        tImg.src = imgPath(entry.id, alt);
        tImg.onerror = function() { tImg.style.display = 'none'; };
      };
      // Label under image
      var label = document.createElement('span');
      label.textContent = entry.title;
      label.style.cssText = [
        'position:absolute;bottom:0;left:0;right:0;',
        'font-size:8px;font-family:var(--font-mono);color:#fff;',
        'background:rgba(0,0,0,0.55);padding:2px 4px;',
        'white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center;',
      ].join('');
      thumb.appendChild(tImg);
      thumb.appendChild(label);
      thumb.addEventListener('mouseenter', function() { thumb.style.transform = 'translateY(-2px)'; thumb.style.borderColor = 'var(--color-text-1)'; });
      thumb.addEventListener('mouseleave', function() { thumb.style.transform = ''; thumb.style.borderColor = i === currentIndex ? 'var(--color-text-1)' : 'var(--color-border)'; });
      thumb.addEventListener('click', function() {
        currentIndex = i;
        restoreWindow();
      });
      tray.appendChild(thumb);
    });
  }

  function minimizeWindow() {
    isMinimized = true;
    imgArea.style.transition = 'opacity 160ms ' + EASE;
    imgArea.style.opacity = '0';
    setTimeout(function() {
      imgArea.style.display = 'none';
      imgArea.style.opacity = '1';
      win.style.aspectRatio = 'unset';
      buildTray();
      tray.style.display = 'flex';
      tray.style.opacity = '0';
      tray.style.transition = 'opacity 160ms ' + EASE;
      void tray.offsetHeight;
      tray.style.opacity = '1';
      if (btnMaximize) btnMaximize.style.opacity = '0.35';
    }, 160);
    if (typeof sounds !== 'undefined') sounds.play('toggle');
  }

  function restoreWindow() {
    isMinimized = false;
    tray.style.transition = 'opacity 120ms ' + EASE;
    tray.style.opacity = '0';
    setTimeout(function() {
      tray.style.display = 'none';
      win.style.aspectRatio = '16/10';
      imgArea.style.display = '';
      imgArea.style.opacity = '0';
      imgArea.style.transition = 'opacity 180ms ' + EASE;
      void imgArea.offsetHeight;
      imgArea.style.opacity = '1';
      if (btnMaximize) btnMaximize.style.opacity = '1';
      loadImage(currentIndex);
    }, 120);
    if (typeof sounds !== 'undefined') sounds.play('toggle');
  }

  function openNextImage() {
    currentIndex = (currentIndex + 1) % HERO_IMAGES.length;
    loadImage(currentIndex);
  }

  var _fsPrevFocus = null;

  function trapFocus(overlayEl, modalEl) {
    var focusable = modalEl.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    var first = focusable[0];
    var last = focusable[focusable.length - 1];
    function handler(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
      else { if (document.activeElement === last) { e.preventDefault(); first.focus(); } }
    }
    overlayEl._trapHandler = handler;
    overlayEl.addEventListener('keydown', handler);
  }

  function openFullscreen() {
    loadFsImage(currentIndex);
    _fsPrevFocus = document.activeElement;
    fsOverlay.classList.add('overlay--open');
    trapFocus(fsOverlay, fsInner);
    var firstFocusable = fsInner.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (firstFocusable) firstFocusable.focus();
    if (typeof sounds !== 'undefined') sounds.play('modalOpen');
  }

  function closeFullscreen() {
    fsOverlay.classList.remove('overlay--open');
    if (fsOverlay._trapHandler) { fsOverlay.removeEventListener('keydown', fsOverlay._trapHandler); fsOverlay._trapHandler = null; }
    if (_fsPrevFocus) { _fsPrevFocus.focus(); _fsPrevFocus = null; }
    if (typeof sounds !== 'undefined') sounds.play('modalClose');
  }

  // Traffic light — Close: close window (fade out), then open next image
  if (btnClose) {
    btnClose.addEventListener('click', function() {
      win.style.transition = 'opacity 180ms ' + EASE;
      win.style.opacity = '0';
      setTimeout(function() {
        openNextImage();
        win.style.opacity = '0';
        void win.offsetHeight;
        win.style.transition = 'opacity 200ms ' + EASE;
        win.style.opacity = '1';
      }, 200);
    });
  }

  // Traffic light — Minimize: shrink to tray bar
  if (btnMinimize) {
    btnMinimize.addEventListener('click', function() {
      if (isMinimized) {
        restoreWindow();
      } else {
        minimizeWindow();
      }
    });
  }

  // Traffic light — Maximize: open fullscreen overlay
  if (btnMaximize) {
    btnMaximize.addEventListener('click', function() {
      if (!isMinimized) openFullscreen();
    });
  }

  // Fullscreen — Close: close overlay and advance image in the background window
  if (fsBtnClose) {
    fsBtnClose.addEventListener('click', function() {
      closeFullscreen();
      openNextImage();
    });
  }

  // Fullscreen — Minimize (restore to window)
  if (fsBtnMinimize) {
    fsBtnMinimize.addEventListener('click', function() {
      closeFullscreen();
    });
  }

  // Fullscreen — Arrow nav
  if (fsBtnPrev) {
    fsBtnPrev.addEventListener('click', function() {
      currentIndex = (currentIndex - 1 + HERO_IMAGES.length) % HERO_IMAGES.length;
      loadFsImage(currentIndex);
      loadImage(currentIndex);
    });
  }
  if (fsBtnNext) {
    fsBtnNext.addEventListener('click', function() {
      currentIndex = (currentIndex + 1) % HERO_IMAGES.length;
      loadFsImage(currentIndex);
      loadImage(currentIndex);
    });
  }

  // Close fullscreen on backdrop click or Escape
  if (fsOverlay) {
    fsOverlay.addEventListener('click', function(e) {
      if (e.target === fsOverlay) closeFullscreen();
    });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && fsOverlay && fsOverlay.classList.contains('overlay--open')) {
      closeFullscreen();
    }
    if (fsOverlay && fsOverlay.classList.contains('overlay--open')) {
      if (e.key === 'ArrowLeft' && fsBtnPrev)  fsBtnPrev.click();
      if (e.key === 'ArrowRight' && fsBtnNext) fsBtnNext.click();
    }
  });

  // Re-sync images when theme changes
  var obs = new MutationObserver(function() {
    if (!isMinimized) loadImage(currentIndex);
    if (fsOverlay && fsOverlay.style.pointerEvents === 'auto') loadFsImage(currentIndex);
    syncFeatureImages();
  });
  obs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // Feature section image sync (dark/light swap)
  function syncFeatureImages() {
    var dark = document.documentElement.className !== 'light';
    document.querySelectorAll('.feat-gif-wrap').forEach(function(wrap) {
      var dImg = wrap.querySelector('.feat-gif-dark');
      var lImg = wrap.querySelector('.feat-gif-light');
      var ph   = wrap.querySelector('.feat-gif-ph');
      var want    = dark ? dImg : lImg;
      var fallback = dark ? lImg : dImg;
      function failed(el) { return el && el.dataset.failed === 'true'; }
      function loaded(el) { return el && el.complete && el.naturalWidth > 0; }
      if (want && !failed(want) && loaded(want)) {
        want.style.display = '';
        if (fallback) fallback.style.display = 'none';
        if (ph) ph.style.display = 'none';
      } else if (fallback && !failed(fallback) && loaded(fallback)) {
        if (want) want.style.display = 'none';
        fallback.style.display = '';
        if (ph) ph.style.display = 'none';
      } else if ((!want || failed(want)) && (!fallback || failed(fallback))) {
        if (want) want.style.display = 'none';
        if (fallback) fallback.style.display = 'none';
        if (ph) ph.style.display = 'flex';
      }
    });
  }

  window.featGifError = function(imgEl) {
    imgEl.dataset.failed = 'true';
    syncFeatureImages();
  };

  // Boot: load first image
  loadImage(0);
  syncFeatureImages();
})();
</script>

<script>
// Install section — toggle wizard
(function() {
  var wizPanel  = document.getElementById('install-panel-wizard');
  var wizToggle = document.getElementById('wiz-toggle');
  var wizIcon   = document.getElementById('wiz-toggle-icon');
  var wizOpen   = false;

  if (wizToggle && wizPanel) {
    wizToggle.addEventListener('click', function() {
      wizOpen = !wizOpen;
      wizPanel.style.display = wizOpen ? '' : 'none';
      if (wizIcon) wizIcon.style.transform = wizOpen ? 'rotate(180deg)' : '';
      if (wizOpen && typeof sounds !== 'undefined') sounds.play('toggle');
    });
  }
})();
</script>

<script>
// Team section — -_- scrolling background
(function() {
  var canvas = document.getElementById('team-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var TILE  = '-_-  ';
  var ANGLE = -12 * Math.PI / 180;
  var SPEED = 28;
  var FSZ   = 16;
  var LH    = Math.round(FSZ * 2.6);
  var off   = 0;
  var last  = null;

  function isDark() { return document.documentElement.className !== 'light'; }

  function resize() {
    canvas.width  = canvas.parentElement.offsetWidth  || window.innerWidth;
    canvas.height = canvas.parentElement.offsetHeight || window.innerHeight;
  }

  function draw(ts) {
    requestAnimationFrame(draw);
    if (last !== null) off += SPEED * (ts - last) / 1000;
    last = ts;
    var wrap = off % LH;
    var W = canvas.width;
    var H = canvas.height;
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.translate(W / 2, H / 2);
    ctx.rotate(ANGLE);
    var D = Math.ceil(Math.sqrt(W * W + H * H));
    ctx.font = 'bold ' + FSZ + 'px monospace';
    ctx.fillStyle = isDark() ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';
    var tw  = ctx.measureText(TILE).width;
    var row = TILE.repeat(Math.ceil((D * 2) / tw) + 2);
    for (var y = -D - LH + wrap; y < D + LH; y += LH) ctx.fillText(row, -D, y);
    ctx.restore();
  }

  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(draw);
})();
</script>

<script>
// ── Commit detail popup ───────────────────────────────────────────────────────
(function () {
  var overlay   = document.getElementById('commit-overlay');
  var modal     = document.getElementById('commit-modal');
  var closeBtn  = document.getElementById('cm-close');
  if (!overlay || !modal) return;

  var EASE = 'cubic-bezier(0.4,0,0.2,1)';

  var _cmPrevFocus = null;

  function trapFocus(overlayEl, modalEl) {
    var focusable = modalEl.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    var first = focusable[0];
    var last = focusable[focusable.length - 1];
    function handler(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
      else { if (document.activeElement === last) { e.preventDefault(); first.focus(); } }
    }
    overlayEl._trapHandler = handler;
    overlayEl.addEventListener('keydown', handler);
  }

  function openCommit(data) {
    document.getElementById('cm-avatar').src   = data.avatar || '';
    document.getElementById('cm-author').textContent = data.author || '';
    document.getElementById('cm-date').textContent   = data.date ? new Date(data.date).toLocaleString() : '';
    document.getElementById('cm-message').textContent = data.msg || '';
    document.getElementById('cm-sha').textContent    = data.sha ? data.sha.slice(0,40) : '';
    document.getElementById('cm-repo').textContent   = data.repo || '';
    document.getElementById('cm-link').href          = data.url  || '#';
    _cmPrevFocus = document.activeElement;
    overlay.classList.add('overlay--open');
    trapFocus(overlay, modal);
    var firstFocusable = modal.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    if (firstFocusable) firstFocusable.focus();
    if (typeof sounds !== 'undefined') sounds.play('modalOpen');
  }

  function closeCommit() {
    overlay.classList.remove('overlay--open');
    if (overlay._trapHandler) { overlay.removeEventListener('keydown', overlay._trapHandler); overlay._trapHandler = null; }
    if (_cmPrevFocus) { _cmPrevFocus.focus(); _cmPrevFocus = null; }
    if (typeof sounds !== 'undefined') sounds.play('modalClose');
  }

  document.addEventListener('click', function (e) {
    var row = e.target.closest('.commit-row');
    if (!row) return;
    try { openCommit(JSON.parse(row.dataset.commit)); } catch (err) {}
  });

  closeBtn.addEventListener('click', closeCommit);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeCommit(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('overlay--open')) closeCommit();
  });
})();

// ── Contributor profile popup ─────────────────────────────────────────────────
