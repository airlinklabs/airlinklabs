<% const rootPrefix='' ; const pageTitle=null; const
  pageDescription='AirLink - open-source game server management. Panel and Daemon, install and run in minutes.' ; var
  homeSidebarLinks=[ { label: 'Start here' , href: '#start' , active: false }, { label: 'Install' , href: '#install' ,
  active: false }, { label: 'Projects' , href: '#projects' , active: false }, { label: 'History' ,
  href: '#history' , active: false }, { label: 'Contributors' , href: '#contributors' , active: false } ]; var
  latestDocs=(docPages || []).slice(0, 5); var latestPosts=(announcements || []).slice(0, 4); %>
  <%- include('./partials/head', { site, underConstruction, rootPrefix, pageTitle, pageDescription }) %>
    <%- include('./partials/nav', { site, underConstruction, rootPrefix, docPages, pageTitle }) %>
      <div class="docs-shell"><%- include('./partials/sidebar', { rootPrefix: rootPrefix, currentPage: 'home' ,
          sidebarLinks: homeSidebarLinks, sidebarSectionLabel: 'Explore' }) %>
          <main class="docs-main">
            <div class="hub-content" id="page-content">
          <!--  <div class="hero-bg" style="background-image:url('<%= rootPrefix %>public/assets/airlink-hero.png')"
                  aria-hidden="true"></div> in works -->
              <section class="hub-hero" id="start" data-animate="blur">
                <div>
                  <p class="hub-overline">Self-hosted · MIT licensed</p>
                  <h1>Game server management<br>built for operators.</h1>
                  <p class="hub-lede">Panel lives in your browser. Daemon lives on each node. Install takes minutes,
                    runs indefinitely, and you own every bit of it.</p>
                  <div class="hub-actions"><a href="#install" class="btn-primary">Install AirLink <svg width="16"
                        height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M12 5v14" />
                        <path d="m19 12-7 7-7-7" />
                      </svg></a><a href="docs/" class="btn-secondary">Read the docs</a></div>
                </div>
              </section>
              <section class="hub-section" id="install" data-animate="fade-up">
                <div class="hub-section-heading">
                  <h2>One command, everything.</h2>
                  <p>Runs on Ubuntu, Debian, Fedora, RHEL, Arch, and Alpine. Installs the panel, daemon, Node.js, and
                    Docker. An interactive TUI walks you through each step.</p>
                </div>
                <div class="install-block">
                  <div class="prose-code-block install-code">
                    <button class="prose-copy-btn" type="button" aria-label="Copy install command">
                      <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      Copy
                    </button>
                    <code>curl -sSL https://raw.githubusercontent.com/airlinklabs/panel/refs/heads/main/installer.sh | bash</code>
                  </div>
                  <p class="install-note">Or install panel only, daemon only, or just addons. Run with
                    <code>--help</code> for flags.
                  </p>
                  <div class="install-options"><a href="docs/deployment-guide/" class="text-link">Full deployment guide
                      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg></a><a href="https://github.com/AirlinkLabs/panel" class="text-link">View source <svg
                        width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M7 7h10v10" />
                        <path d="M7 17 17 7" />
                      </svg></a></div>
                </div>
              </section>
              <section class="hub-section" id="projects" data-animate="fade-up">
                <div class="hub-section-heading">
                  <h2>Projects</h2>
                  <p>Panel is the web interface. Daemon runs on each node and handles the work.</p>
                </div>
                <div class="project-list" data-animate-group><a class="project-row"
                    href="https://github.com/AirlinkLabs/panel">
                    <div class="project-mark">
                      <img src="public/assets/icon.png" alt="" width="25" height="25">
                    </div>
                    <div>
                      <h3>AirLink Panel</h3>
                      <p>Manage servers, users, nodes, images, and backups from a web interface.</p>
                    </div><span class="project-link">View repo <svg width="16" height="16" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        viewBox="0 0 24 24">
                        <path d="M7 7h10v10" />
                        <path d="M7 17 17 7" />
                      </svg></span>
                  </a><a class="project-row" href="https://github.com/AirlinkLabs/daemon">
                    <div class="project-mark project-mark--daemon"><img src="public/assets/icon.png" alt="" width="25"
                        height="25"></div>
                    <div>
                      <h3>AirLink Daemon</h3>
                      <p>Runs on each node to manage containers, files, transfers, and servers.</p>
                    </div><span class="project-link">View repo <svg width="16" height="16" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        viewBox="0 0 24 24">
                        <path d="M7 7h10v10" />
                        <path d="M7 17 17 7" />
                      </svg></span>
                  </a></div>
              </section>
              <section class="hub-section" id="history" data-animate="fade-up">
                <div class="hub-section-heading hub-section-heading--split">
                  <div>
                    <h2>History</h2>
                    <p>Recent commits across panel and daemon, sorted by date.</p>
                  </div>
                  <a href="https://github.com/AirlinkLabs/panel/commits" class="text-link" target="_blank" rel="noopener">View all <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;margin-left:3px"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
                </div>
                <div class="hub-list" id="commit-list" data-animate-group>
                  <p class="hub-empty">Loading commits…</p>
                </div>
              </section>
              <section class="hub-section" id="contributors" data-animate="fade-up">
                <div class="hub-section-heading hub-section-heading--split">
                  <div>
                    <h2>Contributors</h2>
                    <p>People who built AirLink. Contributions from panel and daemon combined.</p>
                  </div>
                  <a href="https://github.com/AirlinkLabs/panel/graphs/contributors" class="text-link" target="_blank" rel="noopener">View all <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;margin-left:3px"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
                </div>
                <div class="contrib-grid" id="contrib-grid">
                  <p class="hub-empty">Loading contributors…</p>
                </div>
              </section>
            </div>
          </main>
      </div>
<script src="<%= rootPrefix %>public/js/github-db.js"></script>
