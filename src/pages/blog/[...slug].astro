---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import site from "../../data/site.json";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const wordCount = post.body?.split(/\s+/).length || 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const next =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const sidebarLinks = allPosts.map((p) => ({
  label: p.data.title,
  href: `/blog/${p.id}/`,
  active: p.id === post.id,
  section: "All posts",
}));
---

<DocsLayout title={`${post.data.title} · Blog`}>
  <Sidebar
    rootPrefix="/"
    currentPage="blog"
    sidebarLinks={sidebarLinks}
    sidebarSectionLabel="All posts"
    site={site}
  />

  <div class="docs-main">
    <header class="docs-header">
      <div class="docs-breadcrumb">
        <a href="/">Home</a>
        <iconify-icon icon="lucide:chevron-right" width="14" height="14"
        ></iconify-icon>
        <a href="/blog/">Blog</a>
        <iconify-icon icon="lucide:chevron-right" width="14" height="14"
        ></iconify-icon>
        <span>{post.data.title}</span>
      </div>
    </header>

    <article class="docs-content">
      <div class="blog-article-header">
        <div class="blog-article-author">
          {
            post.data.authorGithub ? (
              <a
                href={`https://github.com/${post.data.authorGithub}`}
                target="_blank"
                rel="noopener"
                class="blog-avatar-link"
              >
                <img
                  src={`https://github.com/${post.data.authorGithub}.png`}
                  alt={post.data.author}
                  width="36"
                  height="36"
                  class="blog-avatar"
                />
              </a>
            ) : (
              <div class="blog-avatar blog-avatar--fallback">
                {post.data.author.charAt(0).toUpperCase()}
              </div>
            )
          }
          <div class="blog-author-info">
            <span class="blog-author-name">{post.data.author}</span>
            <div class="blog-article-meta">
              <time datetime={post.data.date.toISOString()}>
                {
                  post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                }
              </time>
              <span class="blog-meta-sep">&middot;</span>
              <span>{wordCount.toLocaleString()} words</span>
              <span class="blog-meta-sep">&middot;</span>
              <span>{readTime} min read</span>
            </div>
          </div>
        </div>

        <h1>{post.data.title}</h1>
      </div>

      <div class="blog-body">
        <Content />
      </div>

      {
        next && (
          <nav class="blog-next">
            <span class="blog-next-label">Next post</span>
            <a href={`/blog/${next.id}/`} class="blog-next-link">
              <span>{next.data.title}</span>
              <iconify-icon icon="lucide:arrow-right" width="14" height="14" />
            </a>
          </nav>
        )
      }

      <div class="blog-back">
        <a href="/blog/">
          <iconify-icon icon="lucide:arrow-left" width="14" height="14"
          ></iconify-icon>
          All posts
        </a>
      </div>
    </article>
  </div>
</DocsLayout>

<style>
  .docs-main {
    margin-left: clamp(240px, 19vw, 300px);
    flex: 1;
    min-width: 0;
    min-height: 100vh;
  }
  @media (max-width: 860px) {
    .docs-main {
      margin-left: 0;
    }
  }

  .docs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 16px 32px;
  }
  @media (max-width: 768px) {
    .docs-header {
      padding: 12px 16px;
    }
  }

  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-text-3);
  }
  .docs-breadcrumb a {
    color: var(--color-text-3);
    text-decoration: none;
    transition:
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard),
      opacity var(--dur-default) var(--ease-standard);
  }
  .docs-breadcrumb a:hover {
    color: var(--color-text-2);
  }

  .docs-content {
    width: 100%;
    max-width: 100%;
    padding: clamp(20px, 3vw, 48px) clamp(12px, 2vw, 32px)
      clamp(48px, 6vw, 100px);
  }
  @media (max-width: 768px) {
    .docs-content {
      padding: 24px 16px;
    }
  }

  .blog-article-header {
    margin-bottom: 32px;
  }

  .blog-article-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .blog-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
  }
  .blog-avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-2);
    font-size: 14px;
    font-weight: 600;
    border: none;
  }
  .blog-avatar-link {
    display: flex;
  }

  .blog-author-name {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-1);
  }
  .blog-article-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-text-3);
    margin-top: 2px;
  }
  .blog-meta-sep {
    color: var(--color-border);
  }

  .docs-content h1 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    color: var(--color-text-1);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .blog-body {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-2);
  }
  .blog-body :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-text-1);
    margin: 32px 0 12px;
    padding-top: 16px;
  }
  .blog-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-1);
    margin: 24px 0 8px;
  }
  .blog-body :global(p) {
    margin: 0 0 16px;
  }
  .blog-body :global(a) {
    color: var(--color-text-1);
    text-decoration: none;
    transition:
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard),
      opacity var(--dur-default) var(--ease-standard);
  }
  .blog-body :global(a:hover) {
    color: var(--color-text-1);
    text-decoration: underline;
  }
  .doc-body :global(pre),
  .blog-body :global(pre) {
    position: relative;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 0 0 1.25rem;
    tab-size: 2;
  }

  .doc-body :global(pre code),
  .blog-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 13px;
    font-family: var(--font-mono);
    line-height: 1.65;
    color: var(--color-text-1);
  }

  .doc-body :global(code),
  .blog-body :global(code) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-1);
    padding: 2px 6px;
    border-radius: 5px;
    font-size: 13px;
    font-family: var(--font-mono);
  }

  .doc-body :global(pre code),
  .blog-body :global(pre code) {
    background: none;
    border: none;
    color: var(--color-text-1);
    padding: 0;
  }
  .doc-body :global(table),
  .blog-body :global(table) {
    width: 100%;
    margin: 0 0 1.5rem;
    font-size: 13.5px;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    display: table;
  }

  .doc-body :global(.table-wrapper),
  .blog-body :global(.table-wrapper) {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 1.5rem;
    border-radius: 10px;
  }

  .doc-body :global(.table-wrapper table),
  .blog-body :global(.table-wrapper table) {
    margin: 0;
  }

  .doc-body :global(th),
  .blog-body :global(th) {
    padding: 10px 14px;
    background: var(--color-bg-3);
    color: var(--color-text-1);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }

  .doc-body :global(th:first-child),
  .blog-body :global(th:first-child) {
    border-top-left-radius: 9px;
  }
  .doc-body :global(th:last-child),
  .blog-body :global(th:last-child) {
    border-top-right-radius: 9px;
  }

  .doc-body :global(td),
  .blog-body :global(td) {
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-2);
    vertical-align: top;
    line-height: 1.5;
  }

  .doc-body :global(tr:last-child td),
  .blog-body :global(tr:last-child td) {
    border-bottom: none;
  }

  .doc-body :global(tr:last-child td:first-child),
  .blog-body :global(tr:last-child td:first-child) {
    border-bottom-left-radius: 9px;
  }
  .doc-body :global(tr:last-child td:last-child),
  .blog-body :global(tr:last-child td:last-child) {
    border-bottom-right-radius: 9px;
  }

  .doc-body :global(tbody tr:nth-child(even) td),
  .blog-body :global(tbody tr:nth-child(even) td) {
    background: rgba(255, 255, 255, 0.02);
  }

  .doc-body :global(td code),
  .blog-body :global(td code) {
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--color-bg-input);
    white-space: nowrap;
  }
  .blog-body :global(blockquote) {
    margin: 0 0 16px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--color-text-2);
  }
  .blog-body :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }
  .blog-body :global(ul),
  .blog-body :global(ol) {
    margin: 0 0 16px;
    padding-left: 24px;
  }
  .blog-body :global(li) {
    margin-bottom: 4px;
  }

  .blog-next {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }
  .blog-next-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-3);
    margin-bottom: 6px;
  }
  .blog-next-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text-1);
    font-size: 15px;
    font-weight: 500;
    border: 1px solid var(--color-border);
    transition:
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard),
      opacity var(--dur-default) var(--ease-standard);
  }
  .blog-next-link:hover {
    background: var(--color-text-1);
    color: var(--color-bg);
    border-color: var(--color-text-1);
  }

  .blog-back {
    margin-top: 20px;
  }
  .blog-back a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-text-3);
    text-decoration: none;
    transition:
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard),
      opacity var(--dur-default) var(--ease-standard);
  }
  .blog-back a:hover {
    color: var(--color-text-2);
  }

  @media (max-width: 480px) {
    .blog-article-author {
      flex-wrap: wrap;
    }
    .blog-article-meta {
      flex-wrap: wrap;
      gap: 4px 8px;
    }
    .blog-meta-sep {
      display: none;
    }
    .blog-next-link {
      font-size: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .blog-next {
      padding: 16px 0;
    }
    .docs-breadcrumb {
      flex-wrap: wrap;
      row-gap: 2px;
    }
  }
</style>
