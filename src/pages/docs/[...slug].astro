---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import site from "../../data/site.json";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const docs = await getCollection("docs");
const sorted = docs.sort((a, b) => {
  if (a.data.section !== b.data.section)
    return a.data.section.localeCompare(b.data.section);
  return a.data.order - b.data.order;
});

const currentIndex = sorted.findIndex((d) => d.id === doc.id);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

const grouped = sorted.reduce<Record<string, typeof docs>>((acc, d) => {
  const section = d.data.section;
  if (!acc[section]) acc[section] = [];
  acc[section].push(d);
  return acc;
}, {});

const sections = Object.keys(grouped).sort((a, b) => {
  const orderA = grouped[a][0]?.data.order ?? Infinity;
  const orderB = grouped[b][0]?.data.order ?? Infinity;
  return orderA - orderB;
});

const sidebarLinks = sections.flatMap((section) =>
  grouped[section].map((d) => ({
    label: d.data.title,
    href: `/docs/${d.id}/`,
    active: d.id === doc.id,
    section,
  })),
);

const docHeadings = headings.map((h) => ({
  id: h.slug,
  text: h.text,
  level: h.depth,
}));

const author = doc.data.author || "bthavanish";
---

<DocsLayout
  title={`${doc.data.title} · Docs`}
  description={doc.data.description}
>
  <Sidebar
    rootPrefix="/"
    currentPage="docs"
    sidebarLinks={sidebarLinks}
    sidebarSectionLabel="Documentation"
    docHeadings={docHeadings}
    site={site}
  />

  <div class="docs-main">
    <header class="docs-header">
      <div class="docs-breadcrumb">
        <a href="/">Home</a>
        <iconify-icon icon="lucide:chevron-right" width="14" height="14"
        ></iconify-icon>
        <a href="/docs/">Docs</a>
        <iconify-icon icon="lucide:chevron-right" width="14" height="14"
        ></iconify-icon>
        <a href={`/docs/?section=${doc.data.section}`}>{doc.data.section}</a>
        <iconify-icon icon="lucide:chevron-right" width="14" height="14"
        ></iconify-icon>
        <span>{doc.data.title}</span>
      </div>
    </header>

    <article class="docs-content">
      <div class="doc-meta">
        <span class="doc-section-badge">{doc.data.section}</span>
      </div>
      <h1>{doc.data.title}</h1>
      <p class="doc-description">{doc.data.description}</p>

      <div class="doc-author-info">
        <img
          class="doc-author-avatar"
          src={`https://avatars.githubusercontent.com/${author}`}
          alt={author}
          width="28"
          height="28"
          loading="lazy"
        />
        <span class="doc-author">By {author}</span>
        {
          doc.data.date && (
            <span class="doc-date">
              {doc.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </span>
          )
        }
      </div>

      <div class="doc-body">
        <Content />
      </div>

      <nav class="doc-pagination">
        {
          prev ? (
            <a href={`/docs/${prev.id}/`} class="doc-pagination-prev">
              <iconify-icon icon="lucide:arrow-left" width="14" height="14" />
              <div>
                <span class="doc-pagination-label">Previous</span>
                <span class="doc-pagination-title">{prev.data.title}</span>
              </div>
            </a>
          ) : (
            <div />
          )
        }
        {
          next ? (
            <a href={`/docs/${next.id}/`} class="doc-pagination-next">
              <div>
                <span class="doc-pagination-label">Next</span>
                <span class="doc-pagination-title">{next.data.title}</span>
              </div>
              <iconify-icon icon="lucide:arrow-right" width="14" height="14" />
            </a>
          ) : (
            <div />
          )
        }
      </nav>
    </article>
  </div>
</DocsLayout>

<style>
  .docs-main {
    margin-left: clamp(240px, 19vw, 300px);
    flex: 1;
    min-width: 0;
    min-height: 100vh;
  }
  @media (max-width: 860px) {
    .docs-main {
      margin-left: 0;
    }
  }

  .docs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 16px 32px;
  }
  @media (max-width: 768px) {
    .docs-header {
      padding: 12px 16px;
    }
  }

  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-text-3);
  }
  .docs-breadcrumb a {
    color: var(--color-text-3);
    text-decoration: none;
    transition:
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard),
      opacity var(--dur-default) var(--ease-standard);
  }
  .docs-breadcrumb a:hover {
    color: var(--color-text-2);
  }

  .docs-content {
    width: 100%;
    max-width: 100%;
    padding: clamp(20px, 3vw, 48px) clamp(12px, 2vw, 32px)
      clamp(48px, 6vw, 100px);
  }
  @media (max-width: 768px) {
    .docs-content {
      padding: 24px 16px;
    }
  }

  .doc-meta {
    margin-bottom: 12px;
  }
  .doc-section-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-2);
  }

  .docs-content h1 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    color: var(--color-text-1);
    margin: 0 0 8px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .doc-description {
    font-size: 16px;
    color: var(--color-text-2);
    margin: 0 0 16px;
    line-height: 1.5;
  }
  .doc-author-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--color-text-3);
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .doc-author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }
  .doc-author {
    color: var(--color-text-2);
  }
  .doc-date {
    color: var(--color-text-3);
  }

  .doc-body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-2);
  }
  .doc-body :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-text-1);
    margin: 32px 0 12px;
    padding-top: 16px;
  }
  .doc-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-1);
    margin: 24px 0 8px;
  }
  .doc-body :global(p) {
    margin: 0 0 16px;
  }
  .doc-body :global(a) {
    color: var(--color-text-1);
    text-decoration: none;
    transition:
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard),
      opacity var(--dur-default) var(--ease-standard);
  }
  .doc-body :global(a:hover) {
    color: var(--color-text-1);
    text-decoration: underline;
  }
  .doc-body :global(pre),
  .blog-body :global(pre) {
    position: relative;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 0 0 1.25rem;
    tab-size: 2;
  }

  .doc-body :global(pre code),
  .blog-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 13px;
    font-family: var(--font-mono);
    line-height: 1.65;
    color: var(--color-text-1);
  }

  .doc-body :global(code),
  .blog-body :global(code) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-1);
    padding: 2px 6px;
    border-radius: 5px;
    font-size: 13px;
    font-family: var(--font-mono);
  }

  .doc-body :global(pre code),
  .blog-body :global(pre code) {
    background: none;
    border: none;
    color: var(--color-text-1);
    padding: 0;
  }
  .doc-body :global(table),
  .blog-body :global(table) {
    width: 100%;
    margin: 0 0 1.5rem;
    font-size: 13.5px;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    display: table;
  }

  .doc-body :global(.table-wrapper),
  .blog-body :global(.table-wrapper) {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 0 1.5rem;
    border-radius: 10px;
  }

  .doc-body :global(.table-wrapper table),
  .blog-body :global(.table-wrapper table) {
    margin: 0;
  }

  .doc-body :global(th),
  .blog-body :global(th) {
    padding: 10px 14px;
    background: var(--color-bg-3);
    color: var(--color-text-1);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    white-space: nowrap;
  }

  .doc-body :global(th:first-child),
  .blog-body :global(th:first-child) {
    border-top-left-radius: 9px;
  }
  .doc-body :global(th:last-child),
  .blog-body :global(th:last-child) {
    border-top-right-radius: 9px;
  }

  .doc-body :global(td),
  .blog-body :global(td) {
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-2);
    vertical-align: top;
    line-height: 1.5;
  }

  .doc-body :global(tr:last-child td),
  .blog-body :global(tr:last-child td) {
    border-bottom: none;
  }

  .doc-body :global(tr:last-child td:first-child),
  .blog-body :global(tr:last-child td:first-child) {
    border-bottom-left-radius: 9px;
  }
  .doc-body :global(tr:last-child td:last-child),
  .blog-body :global(tr:last-child td:last-child) {
    border-bottom-right-radius: 9px;
  }

  .doc-body :global(tbody tr:nth-child(even) td),
  .blog-body :global(tbody tr:nth-child(even) td) {
    background: rgba(255, 255, 255, 0.02);
  }

  .doc-body :global(td code),
  .blog-body :global(td code) {
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--color-bg-input);
    white-space: nowrap;
  }
  .doc-body :global(ul),
  .doc-body :global(ol) {
    margin: 0 0 16px;
    padding-left: 24px;
  }
  .doc-body :global(li) {
    margin-bottom: 4px;
  }
  .doc-body :global(blockquote) {
    margin: 0 0 16px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--color-text-2);
  }

  .doc-pagination {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .doc-pagination-prev,
  .doc-pagination-next {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-text-2);
    border: 1px solid var(--color-border);
    transition:
      transform 200ms var(--ease-standard),
      background var(--dur-default) var(--ease-standard),
      color var(--dur-default) var(--ease-standard),
      border-color var(--dur-default) var(--ease-standard),
      box-shadow var(--dur-default) var(--ease-standard);
    max-width: 45%;
  }
  .doc-pagination-prev:hover,
  .doc-pagination-next:hover {
    background: var(--color-text-1);
    color: var(--color-bg);
    border-color: var(--color-text-1);
    transform: translateY(-1px);
    box-shadow: 2px 4px 16px rgba(0, 0, 0, 0.2);
  }
  .doc-pagination-next {
    margin-left: auto;
    text-align: right;
  }
  .doc-pagination-label {
    display: block;
    font-size: 11px;
    color: var(--color-text-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 150ms;
  }
  .doc-pagination-title {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-1);
    transition: color 150ms;
  }
  .doc-pagination-prev:hover .doc-pagination-label,
  .doc-pagination-next:hover .doc-pagination-label,
  .doc-pagination-prev:hover .doc-pagination-title,
  .doc-pagination-next:hover .doc-pagination-title {
    color: var(--color-bg);
  }

  @media (max-width: 480px) {
    .doc-pagination {
      flex-direction: column;
      gap: 10px;
    }
    .doc-pagination-prev,
    .doc-pagination-next {
      max-width: 100%;
    }
    .doc-pagination-next {
      margin-left: 0;
      text-align: left;
    }
    .docs-breadcrumb {
      flex-wrap: wrap;
      row-gap: 2px;
    }
    .doc-author-info {
      flex-wrap: wrap;
      gap: 8px 12px;
    }
    .doc-author-avatar {
      flex-shrink: 0;
    }
    .doc-body :global(h2) {
      font-size: 18px;
      margin: 24px 0 10px;
    }
    .doc-body :global(h3) {
      font-size: 16px;
      margin: 18px 0 6px;
    }
  }
</style>
