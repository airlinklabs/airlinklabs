---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { Image } from 'astro:assets';
import site from '../data/site.json';
import githubData from '../../public/assets/github-data.json';

const commits = githubData.commits || [];
const contributors = githubData.contributors || [];
const features = site.features || [];

const homeSidebarLinks = [
  { label: 'Start here', href: '#start' },
  { label: 'About', href: '#about' },
  { label: 'Install', href: '#install' },
  { label: 'Features', href: '#features' },
  { label: 'Addons', href: '#addons' },
  { label: 'History', href: '#history' },
  { label: 'Contributors', href: '#contributors' },
];

const featureScreenshots: Record<string, string> = {
  'server-management': '/assets/features/server-management/server-management-dark.png',
  'console': '/assets/features/console/console-dark.png',
  'file-manager': '/assets/features/file-manager/file-manager-dark.png',
  'nodes': '/assets/features/nodes/nodes-dark.png',
  'users': '/assets/features/users/users-dark.png',
  'addons': '/assets/features/addons/addons-dark.png',
  'api': '/assets/features/api/api-dark.png',
  'sftp': '/assets/features/sftp/sftp-dark.png',
  'migrations': '/assets/features/migrations/migrations-dark.png',
  'pterodactyl-eggs': '/assets/features/pterodactyl-eggs/pterodactyl-eggs-dark.png',
};

const teamMembers = [
  { login: 'privt00', role: 'Founder', bio: 'Started AirLink. Handles project direction and infrastructure.' },
  { login: 'bthavanish', role: 'Maintainer', bio: 'Core panel and daemon development. Built the addon system and v2 architecture.' },
  { login: 'achul123', role: 'Original maintainer', bio: 'Set up the original architecture and infrastructure that AirLink runs on.' },
];
---

<BaseLayout
  pageTitle={null}
  description="AirLink - open-source game server management. Panel and Daemon, install and run in minutes."
  bodyClass="docs-shell-body"
>

<Sidebar
  rootPrefix="/"
  currentPage="home"
  sidebarLinks={homeSidebarLinks}
  sidebarSectionLabel="Explore"
  site={site}
/>

<main class="docs-main">
  <div class="hub-content" id="page-content">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <div class="hero-viewport" id="start">
      <div class="hero-bg" aria-hidden="true">
        <Image src="/assets/logo.svg" alt="" width={320} height={320} loading="eager" />
      </div>
      <div class="hero-carousel" aria-hidden="true">
        <div class="hero-carousel-track">
          {['dashboard-dark', 'console-dark', 'nodes-dark', 'file-manager-dark', 'users-dark', 'api-dark'].map((name, i) => (
            <div class="hero-carousel-item">
              <Image
                src={`/assets/${i === 0 ? 'screenshots/' : 'features/' + name.replace('-dark', '/') }${name}.png`}
                alt={i === 0 ? 'Dashboard' : name.replace('-dark', '').replace(/-/g, ' ')}
                width={640} height={400}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </div>
          ))}
          {/* Seamless loop duplicates */}
          {['dashboard-dark', 'console-dark', 'nodes-dark', 'file-manager-dark', 'users-dark', 'api-dark'].map((name, i) => (
            <div class="hero-carousel-item" aria-hidden="true">
              <Image
                src={`/assets/${i === 0 ? 'screenshots/' : 'features/' + name.replace('-dark', '/') }${name}.png`}
                alt=""
                width={640} height={400} loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
      <div id="hero-welcome" class="hero-welcome" aria-hidden="true">
        <p class="hero-welcome-text">Welcome to Airlinklabs</p>
      </div>
      <section class="hub-hero hero-text-animated" data-animate="blur">
        <div>
          <p class="hub-overline">Self-hosted · MIT licensed · Open source</p>
          <h1>Game server management<br/>built for operators.</h1>
          <p class="hub-lede">
            AirLink runs on your hardware. The panel lives in your browser, the daemon runs
            on each node. Install takes minutes, runs indefinitely — you own every bit of it.
          </p>
          <div class="hub-actions">
            <a href="#install" class="btn-primary">
              Install AirLink
              <iconify-icon icon="lucide:arrow-down" width="16" height="16"></iconify-icon>
            </a>
            <a href="/docs/" class="btn-secondary">
              Read the docs
              <iconify-icon icon="lucide:book-open" width="14" height="14"></iconify-icon>
            </a>
            <a href="https://ko-fi.com/airlinklabs" class="btn-secondary" target="_blank" rel="noopener">
              Support us
              <iconify-icon icon="lucide:coffee" width="16" height="16"></iconify-icon>
            </a>
            <a href="https://discord.gg/CmrDB2tRaN" class="btn-secondary" target="_blank" rel="noopener">
              Discord
              <svg width="13" height="13" viewBox="0 0 256 199" fill="currentColor" aria-hidden="true"><path d="M216.856 16.597A208.5 208.5 0 0 0 164.042 0c-2.275 4.113-4.933 9.645-6.766 14.046q-29.538-4.442-58.533 0c-1.832-4.4-4.55-9.933-6.846-14.046a207.8 207.8 0 0 0-52.855 16.638C5.618 67.147-3.443 116.4 1.087 164.956c22.169 16.555 43.653 26.612 64.775 33.193A161 161 0 0 0 79.735 175.3a136.4 136.4 0 0 1-21.846-10.632a109 109 0 0 0 5.356-4.237c42.122 19.702 87.89 19.702 129.51 0a132 132 0 0 0 5.355 4.237c-1.312-3.156-4.254-8.55-8.424-14.661a136 136 0 0 1-21.886 10.653c4.006 8.02 8.638 15.67 13.873 22.848c21.142-6.58 42.646-16.637 64.815-33.213c5.316-56.288-9.08-105.09-38.056-148.36M85.474 135.095c-12.645 0-23.015-11.805-23.015-26.18s10.149-26.2 23.015-26.2s23.236 11.804 23.015 26.2c.02 14.375-10.148 26.18-23.015 26.18m85.051 0c-12.645 0-23.014-11.805-23.014-26.18s10.148-26.2 23.014-26.2c12.867 0 23.236 11.804 23.015 26.2c0 14.375-10.148 26.18-23.015 26.18"/></svg>
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- ── About ──────────────────────────────────────────────────────── -->
    <section class="hub-section" id="about" data-animate="fade-up">
      <div class="hub-section-heading">
        <h2>What AirLink does</h2>
        <p>A self-hosted game server management platform. Install on your own machines, manage game servers through a web interface. No third-party control, no usage limits, no vendor lock-in.</p>
      </div>
      <div class="about-grid" data-animate-group>
        <div class="about-card">
          <div class="about-card-icon">
            <iconify-icon icon="lucide:monitor" width="20" height="20"></iconify-icon>
          </div>
          <h3>Panel</h3>
          <p>The web interface where you manage everything. Create servers, assign resources, monitor performance, manage users, and configure nodes. Built on Node.js, TypeScript, Express, and Prisma.</p>
        </div>
        <div class="about-card">
          <div class="about-card-icon">
            <iconify-icon icon="lucide:cpu" width="20" height="20"></iconify-icon>
          </div>
          <h3>Daemon</h3>
          <p>Runs on every machine hosting game servers. Handles Docker containers, file transfers, SFTP sessions, and resource monitoring. Communicates with the panel over HMAC-signed HTTP.</p>
        </div>
        <div class="about-card">
          <div class="about-card-icon">
            <iconify-icon icon="lucide:users" width="20" height="20"></iconify-icon>
          </div>
          <h3>Community</h3>
          <p>Built by {contributors.length} contributors with {githubData.stats?.totalContributions || '1,200+'} contributions across panel, daemon, and image definitions. Started as a side project, became production software.</p>
        </div>
      </div>
    </section>

    <!-- ── Install ────────────────────────────────────────────────────── -->
    <section class="hub-section hub-section--install" id="install" data-animate="fade-up">
      <div class="section-bg" style="background-image:url('/assets/bg-install.svg')" aria-hidden="true"></div>
      <div class="install-layout">
        <div class="hub-section-heading">
          <h2>One command to get started</h2>
          <p>
            Works on Ubuntu, Debian, Fedora, RHEL, Arch, and Alpine. The installer sets up the panel,
            daemon, Node.js, and Docker. An interactive TUI guides you through each step.
          </p>
        </div>
        <div class="install-block">
          <div class="prose-code-block install-code">
            <button class="prose-copy-btn" type="button" aria-label="Copy install command">
              <iconify-icon icon="lucide:copy" width="11" height="11"></iconify-icon>
              Copy
            </button>
            <code>bash &lt;(curl -s https://raw.githubusercontent.com/airlinklabs/panel/refs/heads/main/installer.sh)</code>
          </div>
          <p class="install-note">
            Install everything at once, or choose individual components. Run with
            <code>--help</code> to see options.
          </p>
          <div class="install-options">
            <a href="/docs/admin/getting-started/" class="text-link">
              Getting started guide
              <iconify-icon icon="lucide:arrow-right" width="14" height="14"></iconify-icon>
            </a>
            <a href="https://github.com/AirlinkLabs/panel" class="text-link" target="_blank" rel="noopener">
              View source
              <iconify-icon icon="lucide:external-link" width="14" height="14"></iconify-icon>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Projects — two repos only ─────────────────────────────────── -->
    <section class="hub-section" id="projects" data-animate="fade-up">
      <div class="hub-section-heading">
        <h2>Two repos, one system</h2>
        <p>Panel is the web interface. Daemon runs on each node and does the actual work. They communicate over HMAC-signed HTTP, so you can run the panel on one machine and daemon on as many nodes as you need.</p>
      </div>
      <div class="project-cards" data-animate-group>
        <a class="project-card" href="https://github.com/AirlinkLabs/panel" target="_blank" rel="noopener">
          <div class="project-card-header">
            <div class="project-mark">
              <img src="/assets/icon.png" alt="" width="25" height="25" loading="lazy" />
            </div>
            <span class="project-link-badge">
              View repo
              <iconify-icon icon="lucide:external-link" width="12" height="12"></iconify-icon>
            </span>
          </div>
          <h3>AirLink Panel</h3>
          <p>TypeScript, Express, Prisma, React. Manages servers, users, nodes, images, backups, addons, and the REST API. Includes the addon marketplace and Pterodactyl egg support.</p>
          <div class="project-tags">
            <span class="tag">TypeScript</span>
            <span class="tag">Express</span>
            <span class="tag">Prisma</span>
            <span class="tag">React</span>
          </div>
        </a>
        <a class="project-card" href="https://github.com/AirlinkLabs/daemon" target="_blank" rel="noopener">
          <div class="project-card-header">
            <div class="project-mark project-mark--daemon">
              <img src="/assets/icon.png" alt="" width="25" height="25" loading="lazy" />
            </div>
            <span class="project-link-badge">
              View repo
              <iconify-icon icon="lucide:external-link" width="12" height="12"></iconify-icon>
            </span>
          </div>
          <h3>AirLink Daemon</h3>
          <p>Runs on each node. Manages Docker containers, filesystem access, SFTP sessions, backups, and resource monitoring. Authenticates with HMAC-SHA256 and nonce-based replay protection.</p>
          <div class="project-tags">
            <span class="tag">Docker</span>
            <span class="tag">SFTP</span>
            <span class="tag">HMAC-SHA256</span>
          </div>
        </a>
      </div>
    </section>

    <!-- ── Features ───────────────────────────────────────────────────── -->
    <section class="hub-section" id="features" data-animate="fade-up">
      <div class="hub-section-heading">
        <h2>Features</h2>
        <p>AirLink covers the full lifecycle: deploy servers, manage users, transfer files, monitor resources, and extend the panel with addons. Every feature ships with a screenshot.</p>
      </div>
      <div class="feature-detail-list" data-animate-group>
        {features.map((feature: any) => (
          <div class="feature-detail-row">
            <div class="feature-detail-text">
              <h3>{feature.title}</h3>
              <p>{feature.description || feature.short}</p>
              {feature.long && <p class="feature-detail-long">{feature.long}</p>}
            </div>
            {featureScreenshots[feature.id] && (
              <div class="feature-detail-screenshot">
                <Image
                  src={featureScreenshots[feature.id]}
                  alt={feature.title}
                  width={640}
                  height={400}
                  loading="lazy"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ── Addons ──────────────────────────────────────────────────────── -->
    <section class="hub-section" id="addons" data-animate="fade-up">
      <div class="hub-section-heading">
        <h2>Addon system</h2>
        <p>
          Addons extend the panel without touching core files. They get their own Express router,
          database access via Prisma, a logger, and a UI registration API. Add sidebar entries,
          server menu items, routes, and database tables.
        </p>
      </div>
      <div class="addon-list" data-animate-group>
        <div class="addon-row">
          <div class="addon-icon">
            <iconify-icon icon="lucide:puzzle" width="18" height="18"></iconify-icon>
          </div>
          <div class="addon-body">
            <div class="addon-header">
              <h3>Modrinth Store</h3>
              <span class="addon-version">v1.6.23</span>
            </div>
            <p>Browse and install Minecraft mods and modpacks from Modrinth directly in the panel. Search, one-click install, real-time download progress.</p>
          </div>
        </div>
        <div class="addon-row">
          <div class="addon-icon">
            <iconify-icon icon="lucide:cloud-upload" width="18" height="18"></iconify-icon>
          </div>
          <div class="addon-body">
            <div class="addon-header">
              <h3>Parachute</h3>
              <span class="addon-version">v1.0.0</span>
            </div>
            <p>Google Drive backups for servers. OAuth connection per server, upload, download, restore. Optional encryption and per-server UUID isolation.</p>
          </div>
        </div>
        <a class="addon-row addon-row--link" href="/docs/features/addons/">
          <div class="addon-icon">
            <iconify-icon icon="lucide:book-open" width="18" height="18"></iconify-icon>
          </div>
          <div class="addon-body">
            <div class="addon-header">
              <h3>Build your own</h3>
              <span class="text-link" style="font-size:12px">
                Read the docs
                <iconify-icon icon="lucide:arrow-right" width="12" height="12"></iconify-icon>
              </span>
            </div>
            <p>The addon docs walk you through creating an addon from scratch. Includes a full tutorial and API reference.</p>
          </div>
        </a>
      </div>
    </section>

    <!-- ── Team ───────────────────────────────────────────────────────── -->
    <section class="hub-section" id="team" data-animate="fade-up">
      <div class="hub-section-heading">
        <h2>Who built this</h2>
        <p>AirLink started as a side project and grew from there. The core team handles panel, daemon, and infrastructure.</p>
      </div>
      <div class="team-grid" data-animate-group>
        {teamMembers.map((member) => {
          const contribData = contributors.find((c: any) => c.login === member.login);
          return (
            <a class="team-card" href={`https://github.com/${member.login}`} target="_blank" rel="noopener">
              <img
                src={contribData?.avatar_url || `https://github.com/${member.login}.png`}
                alt={member.login}
                width="48" height="48"
                loading="lazy"
              />
              <div class="team-card-body">
                <span class="team-name">{contribData?.name || member.login}</span>
                <span class="team-handle">@{member.login} · {member.role}</span>
                <span class="team-bio">{member.bio}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ── History ─────────────────────────────────────────────────────── -->
    <section class="hub-section" id="history" data-animate="fade-up">
      <div class="section-bg" style="background-image:url('/assets/bg-history.svg')" aria-hidden="true"></div>
      <div class="hub-section-heading hub-section-heading--split">
        <div>
          <h2>Recent changes</h2>
          <p>Commits across panel and daemon, sorted by date.</p>
        </div>
        <a href="https://github.com/AirlinkLabs/panel/commits" class="text-link" target="_blank" rel="noopener">
          View all
          <iconify-icon icon="lucide:external-link" width="13" height="13" style="display:inline-block;vertical-align:middle;margin-left:3px"></iconify-icon>
        </a>
      </div>
      <div class="commit-list" id="commit-list" data-animate-group>
        {commits.length > 0 ? (
          commits.slice(0, 20).map((commit: any) => (
            <div class="commit-row">
              <div class="commit-row-main">
                <a href={commit.html_url} target="_blank" rel="noopener" class="commit-message">
                  {commit.message || 'Untitled commit'}
                </a>
                {(commit.additions > 0 || commit.deletions > 0) && (
                  <div class="commit-stats">
                    {commit.additions > 0 && <span class="stat-add">+{commit.additions}</span>}
                    {commit.deletions > 0 && <span class="stat-del">-{commit.deletions}</span>}
                    {commit.files_changed > 0 && <span class="stat-files">{commit.files_changed} file{commit.files_changed !== 1 ? 's' : ''}</span>}
                  </div>
                )}
              </div>
              <div class="commit-meta">
                <span class="commit-repo-badge">
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  {commit.repo || 'airlinklabs/panel'}
                </span>
                {commit.author_name && <span class="commit-author">{commit.author_name}</span>}
                {commit.author_date && <time class="commit-date">{commit.author_date}</time>}
              </div>
            </div>
          ))
        ) : (
          <p class="hub-empty">No commits to display yet.</p>
        )}
      </div>
    </section>

    <!-- ── Contributors ──────────────────────────────────────────────── -->
    <section class="hub-section" id="contributors" data-animate="fade-up">
      <div class="section-bg" style="background-image:url('/assets/bg-contributors.svg')" aria-hidden="true"></div>
      <div class="hub-section-heading hub-section-heading--split">
        <div>
          <h2>Contributors</h2>
          <p>{contributors.length} people who have contributed across panel and daemon.</p>
        </div>
        <a href="https://github.com/AirlinkLabs/panel/graphs/contributors" class="text-link" target="_blank" rel="noopener">
          View all
          <iconify-icon icon="lucide:external-link" width="13" height="13" style="display:inline-block;vertical-align:middle;margin-left:3px"></iconify-icon>
        </a>
      </div>
      <div class="contrib-grid" id="contrib-grid">
        {contributors.length > 0 ? (
          contributors.map((contributor: any) => (
            <a class="contrib-card" href={contributor.html_url || '#'} target="_blank" rel="noopener">
              <img src={contributor.avatar_url || ''} alt={contributor.login || ''} width="40" height="40" loading="lazy" />
              <div class="contrib-card-info">
                <span class="contrib-name">{contributor.name || contributor.login || ''}</span>
                {contributor.login && contributor.name && contributor.name !== contributor.login && (
                  <span class="contrib-handle">@{contributor.login}</span>
                )}
                {contributor.bio && (
                  <span class="contrib-bio">{contributor.bio}</span>
                )}
                <span class="contrib-count">{contributor.contributions} contribution{contributor.contributions !== 1 ? 's' : ''}</span>
              </div>
            </a>
          ))
        ) : (
          <p class="hub-empty">No contributors to display yet.</p>
        )}
      </div>
    </section>

  </div>
</main>

</BaseLayout>