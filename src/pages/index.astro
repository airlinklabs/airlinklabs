---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { Image } from "astro:assets";
import site from "../data/site.json";
import githubData from "../../public/assets/github-data.json";

const commits = githubData.commits || [];
const contributors = githubData.contributors || [];
const features = site.features || [];

const homeSidebarLinks = [
  { label: "Start here", href: "#start" },
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Features", href: "#features" },
  { label: "Install", href: "#install" },
  { label: "Contributors", href: "#contributors" },
  { label: "History", href: "#history" },
];

const featureScreenshots: Record<string, string> = {
  "server-management":
    "/assets/features/server-management/server-management-dark.png",
  console: "/assets/features/console/console-dark.png",
  "file-manager": "/assets/features/file-manager/file-manager-dark.png",
  nodes: "/assets/features/nodes/nodes-dark.png",
  users: "/assets/features/users/users-dark.png",
  addons: "/assets/features/addons/addons-dark.png",
  api: "/assets/features/api/api-dark.png",
  sftp: "/assets/features/sftp/sftp-dark.png",
  migrations: "/assets/features/migrations/migrations-dark.png",
  "pterodactyl-eggs":
    "/assets/features/pterodactyl-eggs/pterodactyl-eggs-dark.png",
};

const featureIcons: Record<string, string> = {
  "server-management": "lucide:server",
  console: "lucide:terminal",
  "file-manager": "lucide:folder-open",
  nodes: "lucide:cpu",
  users: "lucide:users",
  addons: "lucide:puzzle",
  api: "lucide:code-2",
  sftp: "lucide:lock",
  migrations: "lucide:arrow-right-left",
  "pterodactyl-eggs": "lucide:egg",
  schedules: "lucide:calendar-clock",
  backups: "lucide:archive",
  databases: "lucide:database",
  mounts: "lucide:link",
  "server-folders": "lucide:folder-tree",
  "startup-configuration": "lucide:settings",
  subusers: "lucide:user-plus",
  radar: "lucide:scan-search",
};

const extraFeatures = [
  {
    id: "schedules",
    title: "Scheduled Tasks",
    description: "Run commands, power actions, and backups on a cron schedule.",
  },
  {
    id: "backups",
    title: "Server Backups",
    description:
      "Create zip archives of server files with lock, restore, download, and optional S3 storage.",
  },
  {
    id: "databases",
    title: "Database Management",
    description:
      "Provision PostgreSQL databases per server with auto-generated credentials and password rotation.",
  },
  {
    id: "mounts",
    title: "Server Mounts",
    description:
      "Share directories between servers as read-only or read-write bind mounts inside containers.",
  },
  {
    id: "server-folders",
    title: "Server Folders",
    description:
      "Organize servers into named groups on the dashboard with drag-and-drop assignment.",
  },
  {
    id: "startup-configuration",
    title: "Startup Configuration",
    description:
      "Configure Docker images, start commands, and environment variables with per-server overrides.",
  },
  {
    id: "subusers",
    title: "Sub-Users",
    description:
      "Grant other users granular access to specific servers with 19 independent permissions.",
  },
  {
    id: "radar",
    title: "Radar Scanner",
    description:
      "Scan server files for malicious plugins using filename, extension, and content pattern matching with VirusTotal integration.",
  },
];

const teamMembers = [
  {
    github: "privt00",
    name: "privt",
    role: "Founder",
    bio: "Started AirLink. Handles project direction and infrastructure.",
  },
  {
    github: "bthavanish",
    name: "thavanish",
    role: "Maintainer",
    bio: "Core panel and daemon development. Built the addon system and v2 architecture.",
  },
  {
    github: "achul123",
    name: "achul",
    role: "Original maintainer",
    bio: "Set up the original architecture and infrastructure that AirLink runs on.",
  },
];

const milestones = [
  {
    date: "2024",
    title: "First commit",
    description:
      "AirLink begins as a side project — panel and daemon skeletons committed.",
    icon: "lucide:git-commit-horizontal",
  },
  {
    date: "2024",
    title: "First working release",
    description:
      "Server creation, console, file manager, and user system ship in the first public build.",
    icon: "lucide:rocket",
  },
  {
    date: "2024",
    title: "Addon system lands",
    description:
      "Modrinth Store and Parachute ship. Community addons become possible.",
    icon: "lucide:puzzle",
  },
  {
    date: "2025",
    title: "v2 architecture",
    description:
      "Daemon rewritten. HMAC auth, multi-node support, and SFTP sessions.",
    icon: "lucide:cpu",
  },
  {
    date: "2025",
    title: `${contributors.length}+ contributors`,
    description:
      "Community grows past initial team. Panel and daemon both receive external PRs.",
    icon: "lucide:users",
  },
];
---

<BaseLayout
  pageTitle={null}
  description="AirLink - open-source game server management. Panel and Daemon, install and run in minutes."
  bodyClass="docs-shell-body"
>
  <a href="#page-content" class="skip-link">Skip to main content</a>

  <Sidebar
    rootPrefix="/"
    currentPage="home"
    sidebarLinks={homeSidebarLinks}
    sidebarSectionLabel="Explore"
    site={site}
  />

  <main class="docs-main">
    <div class="hub-content" id="page-content">
      <!-- ── Hero ─────────────────────────────────────────────────────────── -->
      <div class="hero-viewport" id="start">
        <div class="hero-bg" aria-hidden="true">
          <Image
            src="/assets/logo.svg"
            alt=""
            width={320}
            height={320}
            loading="eager"
          />
        </div>
        <div class="hero-layout">
          <section class="hub-hero hero-text-animated" data-animate="blur">
            <div>
              <p class="hub-overline">
                Self-hosted · MIT licensed · Open source
              </p>
              <h1>Game server management<br />built for operators.</h1>
              <p class="hub-lede">
                AirLink runs on your hardware. The panel lives in your browser,
                the daemon runs on each node. Install takes minutes and runs
                indefinitely — you own every bit of it.
              </p>
              <div class="hub-actions">
                <a href="#install" class="btn-primary">
                  Install AirLink
                  <iconify-icon
                    icon="lucide:arrow-down"
                    width="16"
                    height="16"
                    aria-hidden="true"></iconify-icon>
                </a>
                <a href="/docs/" class="btn-secondary">
                  Read the docs
                  <iconify-icon
                    icon="lucide:book-open"
                    width="14"
                    height="14"
                    aria-hidden="true"></iconify-icon>
                </a>
              </div>
            </div>
          </section>
          <div class="hero-carousel" aria-hidden="true">
            <div class="hero-carousel-track">
              {
                [
                  {
                    src: "/assets/screenshots/dashboard-dark.png",
                    label: "Dashboard",
                    desc: "Server overview with real-time metrics, player counts, and resource usage.",
                  },
                  {
                    src: "/assets/features/console/console-dark.png",
                    label: "Console",
                    desc: "Live server console with command history and auto-scroll.",
                  },
                  {
                    src: "/assets/features/nodes/nodes-dark.png",
                    label: "Nodes",
                    desc: "Multi-node management with daemon status and allocation overview.",
                  },
                  {
                    src: "/assets/features/file-manager/file-manager-dark.png",
                    label: "File Manager",
                    desc: "Browser-based file editor with syntax highlighting and bulk operations.",
                  },
                  {
                    src: "/assets/features/users/users-dark.png",
                    label: "Users",
                    desc: "User roles, permissions, and sub-user access control.",
                  },
                  {
                    src: "/assets/features/api/api-dark.png",
                    label: "API",
                    desc: "RESTful API with HMAC authentication for programmatic access.",
                  },
                ].map(({ src, label, desc }, i) => (
                  <div class="hero-carousel-item" data-desc={desc}>
                    <Image
                      src={src}
                      alt={label}
                      width={640}
                      height={400}
                      loading={i < 2 ? "eager" : "lazy"}
                    />
                    <span class="hero-carousel-label">{label}</span>
                  </div>
                ))
              }
              {
                [
                  {
                    src: "/assets/screenshots/dashboard-dark.png",
                    label: "Dashboard",
                  },
                  {
                    src: "/assets/features/console/console-dark.png",
                    label: "Console",
                  },
                  {
                    src: "/assets/features/nodes/nodes-dark.png",
                    label: "Nodes",
                  },
                  {
                    src: "/assets/features/file-manager/file-manager-dark.png",
                    label: "File Manager",
                  },
                  {
                    src: "/assets/features/users/users-dark.png",
                    label: "Users",
                  },
                  { src: "/assets/features/api/api-dark.png", label: "API" },
                ].map(({ src, label }) => (
                  <div class="hero-carousel-item" aria-hidden="true">
                    <Image
                      src={src}
                      alt=""
                      width={640}
                      height={400}
                      loading="lazy"
                    />
                    <span class="hero-carousel-label">{label}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div
        class="hero-popup-overlay"
        id="hero-popup"
        role="dialog"
        aria-modal="true"
        aria-labelledby="hero-popup-desc"
      >
        <div class="hero-popup-content">
          <button class="hero-popup-close" id="hero-popup-close" type="button"
            >&times;</button
          >
          <img
            id="hero-popup-img"
            src=""
            alt=""
            aria-describedby="hero-popup-desc"
          />
          <div class="hero-popup-desc" id="hero-popup-desc"></div>
        </div>
      </div>

      <div
        class="feature-popup-overlay"
        id="feature-popup"
        role="dialog"
        aria-modal="true"
        aria-labelledby="feature-popup-title"
      >
        <div class="feature-popup-content">
          <div class="feature-popup-left">
            <img id="feature-popup-img" src="" alt="" />
          </div>
          <div class="feature-popup-right">
            <button
              class="feature-popup-close"
              id="feature-popup-close"
              type="button">&times;</button
            >
            <h3 id="feature-popup-title"></h3>
            <p id="feature-popup-desc" class="feature-popup-desc"></p>
            <p id="feature-popup-long" class="feature-popup-long"></p>
          </div>
        </div>
      </div>

      <!-- ── About + Features ──────────────────────────────────────────── -->
      <section class="hub-section" id="about" data-animate="fade-up">
        <div class="hub-section-heading">
          <h2>What AirLink does</h2>
          <p>
            Install on your own machines, manage game servers through a web
            interface. No third-party control, no usage limits, no lock-in.
          </p>
        </div>
        <div class="about-grid">
          <button
            class="about-card about-card--active"
            type="button"
            data-about="panel"
          >
            <div class="about-card-icon">
              <iconify-icon icon="lucide:monitor" width="20" height="20"
              ></iconify-icon>
            </div>
            <h3>Panel</h3>
            <p>The web interface where you manage everything.</p>
          </button>
          <button class="about-card" type="button" data-about="daemon">
            <div class="about-card-icon">
              <iconify-icon icon="lucide:cpu" width="20" height="20"
              ></iconify-icon>
            </div>
            <h3>Daemon</h3>
            <p>Runs on every machine hosting game servers.</p>
          </button>
          <button class="about-card" type="button" data-about="community">
            <div class="about-card-icon">
              <iconify-icon icon="lucide:users" width="20" height="20"
              ></iconify-icon>
            </div>
            <h3>Community</h3>
            <p>Built by {contributors.length} contributors.</p>
          </button>
        </div>
        <!-- Panel showcase -->
        <div
          class="feature-showcase feature-showcase--active"
          data-about-showcase="panel"
        >
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>Server Management</h3>
              <p>
                Create game servers with CPU, RAM, and disk limits. Start, stop,
                restart, and kill Docker containers in real time. Assign servers
                to specific nodes and users.
              </p>
              <p class="feature-showcase-detail">
                The admin dashboard shows every server across every node with
                owner, status, and live resource usage. One-click server
                creation from any configured image. Duplicate servers, migrate
                between nodes, and manage power states without touching the
                command line.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/server-management/server-management-dark.png"
                alt="Server Management"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>Console</h3>
              <p>
                Live terminal output streamed over WebSockets. Send commands,
                view logs, and interact with running servers directly from the
                browser.
              </p>
              <p class="feature-showcase-detail">
                Full PTY support for interactive server consoles. Command
                history, auto-scroll, and copy-to-clipboard. No page refreshes —
                output appears as the server produces it.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/console/console-dark.png"
                alt="Console"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>File Manager</h3>
              <p>
                Browse, upload, download, edit, and delete server files. Inline
                code editor with syntax highlighting for config files and source
                code.
              </p>
              <p class="feature-showcase-detail">
                Full directory tree navigation with drag-and-drop uploads.
                Create folders, rename, move, and compress files. Edit
                configuration files in-browser without downloading or using
                external tools.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/file-manager/file-manager-dark.png"
                alt="File Manager"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <!-- Daemon showcase -->
        <div class="feature-showcase" data-about-showcase="daemon">
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>Multi-Node</h3>
              <p>
                Add as many machines as you need. Each node runs its own daemon
                instance and reports resources back to the panel.
              </p>
              <p class="feature-showcase-detail">
                The panel distributes servers across nodes based on resource
                availability. One control plane, unlimited machines. Monitor
                node health, allocations, and connected servers from a single
                dashboard.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/nodes/nodes-dark.png"
                alt="Nodes"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>SFTP</h3>
              <p>
                Built-in SFTP server on every node. No external FTP software
                needed — connect with any standard SFTP client.
              </p>
              <p class="feature-showcase-detail">
                Per-server SFTP access with sandboxed directories. Users
                authenticate through the panel with their existing credentials.
                Upload, download, and manage files over an encrypted connection
                without opening additional ports.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/sftp/sftp-dark.png"
                alt="SFTP"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>Docker Containers</h3>
              <p>
                Every server runs in an isolated Docker container with enforced
                resource limits. CPU, RAM, and disk quotas are configured per
                server.
              </p>
              <p class="feature-showcase-detail">
                Containers are ephemeral — recreate without data loss. Pull and
                manage Docker images from the panel. Set environment variables,
                start commands, and working directories without editing config
                files on disk.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/server-management/server-management-dark.png"
                alt="Docker"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <!-- Community showcase -->
        <div class="feature-showcase" data-about-showcase="community">
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>User Management</h3>
              <p>
                Granular permissions let you assign servers to specific users.
                Admin and regular user roles with sub-user access control for
                team management.
              </p>
              <p class="feature-showcase-detail">
                19 independent permissions per sub-user. Two-factor
                authentication for all accounts. API keys with scoped access for
                programmatic control. Invite users and manage their server
                assignments from the admin panel.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/users/users-dark.png"
                alt="Users"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>REST API</h3>
              <p>
                Full programmatic access to every panel feature. Build custom
                tools, dashboards, and integrations using the same API the
                frontend uses.
              </p>
              <p class="feature-showcase-detail">
                Token-based authentication with HMAC signing. Paginated
                responses for large datasets. Webhook support for server events
                like start, stop, and crash. OpenAPI spec available for code
                generation and client libraries.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/api/api-dark.png"
                alt="API"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
          <div class="feature-showcase-row">
            <div class="feature-showcase-text">
              <h3>Addons</h3>
              <p>
                Community-built extensions that extend AirLink without modifying
                core code. Install from the addon marketplace or build your own.
              </p>
              <p class="feature-showcase-detail">
                Modrinth Store for Minecraft mods and modpacks, Parachute for
                Google Drive backups, and more. Addons run server-side with full
                API access. Create addons using the documented API — no forking
                required.
              </p>
            </div>
            <div class="feature-showcase-screen">
              <Image
                src="/assets/features/addons/addons-dark.png"
                alt="Addons"
                width={720}
                height={450}
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <div class="feature-grid-secondary" data-stagger>
          {
            features.slice(3).map((feature: any) => (
              <button
                class="feature-grid-item feature-grid-trigger"
                type="button"
                data-title={feature.title}
                data-desc={feature.description || feature.short || ""}
                data-long={feature.longDescription || ""}
                data-id={feature.id}
              >
                <iconify-icon
                  icon={featureIcons[feature.id] || "lucide:box"}
                  width="18"
                  height="18"
                  aria-hidden="true"
                />
                <h4>{feature.title}</h4>
                <p>{feature.short || feature.description}</p>
              </button>
            ))
          }
          {
            extraFeatures.map((feature) => (
              <button
                class="feature-grid-item feature-grid-trigger"
                type="button"
                data-title={feature.title}
                data-desc={feature.description || ""}
                data-long=""
                data-id={feature.id}
              >
                <iconify-icon
                  icon={featureIcons[feature.id] || "lucide:box"}
                  width="18"
                  height="18"
                  aria-hidden="true"
                />
                <h4>{feature.title}</h4>
                <p>{feature.description}</p>
              </button>
            ))
          }
        </div>
        <div class="hub-section-heading" style="margin-top: 48px;">
          <h2>Add-ons</h2>
          <p>Extend AirLink with community addons.</p>
        </div>
        <div class="addon-list" data-stagger>
          <div class="addon-row">
            <div class="addon-icon">
              <iconify-icon icon="lucide:puzzle" width="18" height="18"
              ></iconify-icon>
            </div>
            <div class="addon-body">
              <div class="addon-header">
                <h3>Modrinth Store</h3>
                <span class="addon-version">v1.6.23</span>
              </div>
              <p>
                Browse and install Minecraft mods and modpacks from Modrinth
                directly in the panel. Search, one-click install, real-time
                download progress.
              </p>
            </div>
          </div>
          <div class="addon-row">
            <div class="addon-icon">
              <iconify-icon icon="lucide:cloud-upload" width="18" height="18"
              ></iconify-icon>
            </div>
            <div class="addon-body">
              <div class="addon-header">
                <h3>Parachute</h3>
                <span class="addon-version">v1.0.0</span>
              </div>
              <p>
                Google Drive backups for servers. OAuth connection per server,
                upload, download, restore. Optional encryption and per-server
                UUID isolation.
              </p>
            </div>
          </div>
          <a class="addon-row addon-row--link" href="/docs/features/addons/">
            <div class="addon-icon">
              <iconify-icon icon="lucide:book-open" width="18" height="18"
              ></iconify-icon>
            </div>
            <div class="addon-body">
              <div class="addon-header">
                <h3>Build your own</h3>
                <span class="text-link" style="font-size:12px">
                  Read the docs
                  <iconify-icon
                    icon="lucide:arrow-right"
                    width="12"
                    height="12"
                    aria-hidden="true"></iconify-icon>
                </span>
              </div>
              <p>
                The addon docs walk you through creating an addon from scratch.
                Includes a full tutorial and API reference.
              </p>
            </div>
          </a>
        </div>
      </section>

      <!-- ── Projects ─────────────────────────────────────────────────────── -->
      <section class="hub-section" id="projects" data-animate="fade-up">
        <div class="hub-section-heading">
          <h2>Two repos, one system</h2>
          <p>
            Panel is the web interface. Daemon runs on each node and handles the
            real work. They talk over HMAC-signed HTTP, so one panel can talk to
            as many nodes as you need.
          </p>
        </div>
        <div class="project-cards" data-stagger>
          <a
            class="project-card"
            href="https://github.com/AirlinkLabs/panel"
            target="_blank"
            rel="noopener"
          >
            <div class="project-card-header">
              <div class="project-mark">
                <img
                  src="/assets/icon.png"
                  alt=""
                  width="25"
                  height="25"
                  loading="lazy"
                />
              </div>
              <span class="project-link-badge">
                View repo
                <iconify-icon
                  icon="lucide:external-link"
                  width="12"
                  height="12"
                  aria-hidden="true"></iconify-icon>
              </span>
            </div>
            <h3>AirLink Panel</h3>
            <p>
              TypeScript, Express, Prisma, React. Manages servers, users, nodes,
              images, backups, addons, and the REST API. Includes the addon
              marketplace and Pterodactyl egg support.
            </p>
            <div class="project-tags">
              <span class="tag">TypeScript</span>
              <span class="tag">Express</span>
              <span class="tag">Prisma</span>
              <span class="tag">React</span>
            </div>
          </a>
          <a
            class="project-card"
            href="https://github.com/AirlinkLabs/daemon"
            target="_blank"
            rel="noopener"
          >
            <div class="project-card-header">
              <div class="project-mark project-mark--daemon">
                <img
                  src="/assets/icon.png"
                  alt=""
                  width="25"
                  height="25"
                  loading="lazy"
                />
              </div>
              <span class="project-link-badge">
                View repo
                <iconify-icon
                  icon="lucide:external-link"
                  width="12"
                  height="12"
                  aria-hidden="true"></iconify-icon>
              </span>
            </div>
            <h3>AirLink Daemon</h3>
            <p>
              Runs on each node. Manages Docker containers, filesystem access,
              SFTP sessions, backups, and resource monitoring. Authenticates
              with HMAC-SHA256 and nonce-based replay protection.
            </p>
            <div class="project-tags">
              <span class="tag">Docker</span>
              <span class="tag">SFTP</span>
              <span class="tag">HMAC-SHA256</span>
            </div>
          </a>
        </div>
      </section>

      <!-- ── Install ────────────────────────────────────────────────────── -->
      <section
        class="hub-section hub-section--install"
        id="install"
        data-animate="fade-up"
      >
        <div
          class="section-bg"
          style="background-image:url('/assets/bg-install.svg')"
          aria-hidden="true"
        >
        </div>
        <div class="install-layout">
          <div class="hub-section-heading">
            <h2>One command to install</h2>
            <p>
              Works on Ubuntu, Debian, Fedora, RHEL, Arch, and Alpine. The
              installer sets up Node.js, Docker, the panel, and daemon. An
              interactive TUI walks you through each step.
            </p>
          </div>
          <div class="install-block">
            <div class="prose-code-block install-code">
              <button
                class="prose-copy-btn"
                type="button"
                aria-label="Copy install command"
              >
                <iconify-icon icon="lucide:copy" width="11" height="11"
                ></iconify-icon>
                Copy
              </button>
              <code
                >bash &lt;(curl -s
                https://raw.githubusercontent.com/airlinklabs/panel/refs/heads/main/installer.sh)</code
              >
            </div>
            <p class="install-note">
              Install everything at once, or choose individual components. Run
              with
              <code>--help</code> to see options.
            </p>
            <div class="install-options">
              <a href="/docs/admin/getting-started/" class="text-link">
                Getting started guide
                <iconify-icon
                  icon="lucide:arrow-right"
                  width="14"
                  height="14"
                  aria-hidden="true"></iconify-icon>
              </a>
              <a
                href="https://github.com/AirlinkLabs/panel"
                class="text-link"
                target="_blank"
                rel="noopener"
              >
                View source
                <iconify-icon
                  icon="lucide:external-link"
                  width="14"
                  height="14"
                  aria-hidden="true"></iconify-icon>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Contributors──────────────────────────────────── -->
      <section class="hub-section" id="contributors" data-animate="fade-up">
        <div
          class="section-bg"
          style="background-image:url('/assets/bg-contributors.svg')"
          aria-hidden="true"
        >
        </div>
        <div class="hub-section-heading hub-section-heading--split">
          <div>
            <h2>Contributors</h2>
            <p>
              {contributors.length} people who have contributed across panel and daemon.
            </p>
          </div>
          <a
            href="https://github.com/AirlinkLabs/panel/graphs/contributors"
            class="text-link"
            target="_blank"
            rel="noopener"
          >
            View all
            <iconify-icon
              icon="lucide:external-link"
              width="13"
              height="13"
              style="display:inline-block;vertical-align:middle;margin-left:3px"
              aria-hidden="true"></iconify-icon>
          </a>
        </div>

        <div class="team-grid" data-stagger>
          {
            teamMembers.map((member: any) => (
              <a
                class="team-card team-card--horizontal"
                href={`https://github.com/${member.github}`}
                target="_blank"
                rel="noopener"
              >
                <div class="team-card-body">
                  <p class="team-card-name">{member.name}</p>
                  <p class="team-card-role">{member.role}</p>
                  <p class="team-card-bio">{member.bio}</p>
                  <div class="team-card-footer">
                    <iconify-icon
                      icon="lucide:github"
                      width="12"
                      height="12"
                      aria-hidden="true"
                    />
                    <span>@{member.github}</span>
                  </div>
                </div>
                <div class="team-card-avatar">
                  <img
                    src={`https://avatars.githubusercontent.com/${member.github}?s=120`}
                    alt={member.name}
                    width="80"
                    height="80"
                    loading="lazy"
                  />
                </div>
              </a>
            ))
          }
        </div>

        <div class="contrib-grid" id="contrib-grid">
          {
            contributors.length > 0 ? (
              contributors
                .filter(
                  (c: any) =>
                    !teamMembers.some((m: any) => m.github === c.login),
                )
                .map((contributor: any) => (
                  <a
                    class="contrib-card-full"
                    href={contributor.html_url}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${contributor.name || contributor.login} — ${contributor.contributions} contribution${contributor.contributions !== 1 ? "s" : ""}`}
                  >
                    <img
                      src={contributor.avatar_url}
                      alt=""
                      width="44"
                      height="44"
                      loading="lazy"
                    />
                    <div class="contrib-card-full-info">
                      <span class="contrib-card-full-name">
                        {contributor.name || contributor.login}
                      </span>
                      <span class="contrib-card-full-handle">
                        @{contributor.login}
                      </span>
                    </div>
                    <span class="contrib-card-full-count">
                      {contributor.contributions}
                    </span>
                  </a>
                ))
            ) : (
              <p class="hub-empty">No contributors to display yet.</p>
            )
          }
        </div>
      </section>

      <!-- ── History ─────────────────────────────────────────────────────── -->
      <section
        class="hub-section hub-section--last"
        id="history"
        data-animate="fade-up"
      >
        <div
          class="section-bg"
          style="background-image:url('/assets/bg-history.svg')"
          aria-hidden="true"
        >
        </div>
        <div class="hub-section-heading hub-section-heading--split">
          <div>
            <h2>Recent changes</h2>
            <p>Commits across panel and daemon, sorted by date.</p>
          </div>
          <a
            href="https://github.com/AirlinkLabs/panel/commits"
            class="text-link"
            target="_blank"
            rel="noopener"
          >
            View all
            <iconify-icon
              icon="lucide:external-link"
              width="13"
              height="13"
              style="display:inline-block;vertical-align:middle;margin-left:3px"
              aria-hidden="true"></iconify-icon>
          </a>
        </div>
        <div class="commit-list" id="commit-list" data-stagger>
          {
            commits.length > 0 ? (
              commits.slice(0, 5).map((commit: any) => (
                <a
                  class="commit-row"
                  href={commit.html_url}
                  target="_blank"
                  rel="noopener"
                >
                  <div class="commit-row-main">
                    <span class="commit-message">
                      {commit.message || "Untitled commit"}
                    </span>
                    {(commit.additions > 0 || commit.deletions > 0) && (
                      <div class="commit-stats">
                        {commit.additions > 0 && (
                          <span class="stat-add">+{commit.additions}</span>
                        )}
                        {commit.deletions > 0 && (
                          <span class="stat-del">-{commit.deletions}</span>
                        )}
                        {commit.files_changed > 0 && (
                          <span class="stat-files">
                            {commit.files_changed} file
                            {commit.files_changed !== 1 ? "s" : ""}
                          </span>
                        )}
                      </div>
                    )}
                  </div>
                  <div class="commit-meta">
                    <span class="commit-repo-badge">
                      <svg
                        viewBox="0 0 24 24"
                        width="11"
                        height="11"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <>
                          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                          <path d="M9 18c-4.51 2-5-2-7-2" />
                        </>
                      </svg>
                      {commit.repo || "airlinklabs/panel"}
                    </span>
                    {commit.author_name && (
                      <span class="commit-author">{commit.author_name}</span>
                    )}
                    {commit.author_date && (
                      <time class="commit-date" datetime={commit.author_date}>
                        {commit.author_date}
                      </time>
                    )}
                  </div>
                </a>
              ))
            ) : (
              <p class="hub-empty">No commits to display yet.</p>
            )
          }
        </div>
        {
          commits.length > 5 && (
            <div class="commit-more-wrap">
              <button
                class="commit-more-btn"
                id="commit-more-btn"
                type="button"
                aria-expanded="false"
              >
                Show {commits.length - 5} more commits
              </button>
            </div>
          )
        }
      </section>
    </div>

    <div
      class="commit-popup-overlay"
      id="commit-popup"
      role="dialog"
      aria-modal="true"
      aria-labelledby="commit-popup-heading"
    >
      <div class="commit-popup-content">
        <div class="commit-popup-header">
          <h3 id="commit-popup-heading">All commits</h3>
          <button
            class="commit-popup-close"
            id="commit-popup-close"
            type="button">&times;</button
          >
        </div>
        <div class="commit-popup-body">
          {
            commits.slice(5).map((commit: any) => (
              <a
                class="commit-row"
                href={commit.html_url}
                target="_blank"
                rel="noopener"
              >
                <div class="commit-row-main">
                  <span class="commit-message">
                    {commit.message || "Untitled commit"}
                  </span>
                  {(commit.additions > 0 || commit.deletions > 0) && (
                    <div class="commit-stats">
                      {commit.additions > 0 && (
                        <span class="stat-add">+{commit.additions}</span>
                      )}
                      {commit.deletions > 0 && (
                        <span class="stat-del">-{commit.deletions}</span>
                      )}
                      {commit.files_changed > 0 && (
                        <span class="stat-files">
                          {commit.files_changed} file
                          {commit.files_changed !== 1 ? "s" : ""}
                        </span>
                      )}
                    </div>
                  )}
                </div>
                <div class="commit-meta">
                  <span class="commit-repo-badge">
                    <svg
                      viewBox="0 0 24 24"
                      width="11"
                      height="11"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <>
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                        <path d="M9 18c-4.51 2-5-2-7-2" />
                      </>
                    </svg>
                    {commit.repo || "airlinklabs/panel"}
                  </span>
                  {commit.author_name && (
                    <span class="commit-author">{commit.author_name}</span>
                  )}
                  {commit.author_date && (
                    <time class="commit-date" datetime={commit.author_date}>
                      {commit.author_date}
                    </time>
                  )}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
