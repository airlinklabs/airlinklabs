---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import Sidebar from "../components/Sidebar.astro";

const homeSidebarLinks = [{ label: "404", href: "#" }];
---

<BaseLayout
  pageTitle="404"
  description={`Page not found — ${site.title}`}
  bodyClass="docs-shell-body"
>
  <Sidebar
    rootPrefix="/"
    currentPage="404"
    sidebarLinks={homeSidebarLinks}
    sidebarSectionLabel="Explore"
    site={site}
  />

  <main class="docs-main">
    <div class="not-found" id="page-content" data-animate="blur">
      <p class="not-found-code">404 / ROUTE_MISSING</p>
      <h1>Page not found.</h1>
      <p>
        This page may have moved or been removed. The rest of the site is where
        you left it.
      </p>
      <div>
        <a href="/" class="btn-primary">
          Back to home
          <iconify-icon icon="lucide:arrow-right" width="16" height="16"
          ></iconify-icon>
        </a>
        <a href="/docs/" class="btn-secondary">Read the docs</a>
      </div>
      <code id="not-found-path"></code>
    </div>
  </main>

  <script is:inline>
    document.getElementById("not-found-path").textContent =
      window.location.pathname || "/";
  </script>
</BaseLayout>
