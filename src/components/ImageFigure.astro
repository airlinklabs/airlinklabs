---
interface Props {
  src: string;
  caption?: string;
  full?: boolean;
}

const { src, caption, full = false } = Astro.props;
---

<figure class:list={["image-figure", { "image-figure--full": full }]}>
  <img src={src} alt={caption ?? ""} loading="lazy" decoding="async" />
  {caption && <figcaption class="image-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .image-figure {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .image-figure--full {
    margin-left: calc(-1 * var(--gap, 2rem));
    margin-right: calc(-1 * var(--gap, 2rem));
  }

  .image-figure img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .image-figure__caption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-muted, #94a3b8);
    text-align: center;
  }
</style>
