---
interface SidebarLink {
  label: string;
  href: string;
  active?: boolean;
  section?: string;
}
interface Heading {
  id: string;
  text: string;
  level: number;
}
interface Props {
  rootPrefix?: string;
  currentPage?: string;
  sidebarLinks?: SidebarLink[];
  sidebarSectionLabel?: string;
  docHeadings?: Heading[];
  site?: { title: string; description: string; siteUrl?: string };
}

const {
  rootPrefix = '/',
  currentPage = 'home',
  sidebarLinks,
  sidebarSectionLabel = 'In this section',
  docHeadings,
  site,
} = Astro.props;

const page = currentPage.toLowerCase();
const active = page === '' ? 'home' : page;

const navLinks = [
  { key: 'home', href: rootPrefix,          label: 'Home', icon: 'lucide:home' },
  { key: 'docs', href: `${rootPrefix}docs/`, label: 'Docs', icon: 'lucide:book-open' },
  { key: 'blog', href: `${rootPrefix}blog/`, label: 'Blog', icon: 'lucide:newspaper' },
];
---

<aside class="site-sidebar">
  <div class="site-sidebar-header">
    <a href={rootPrefix} class="site-sidebar-logo">
      <img src={`${rootPrefix}assets/icon.png`} alt="" width="24" height="24" />
      <span>AirLink</span>
    </a>
  </div>

  <nav class="site-sidebar-nav" aria-label="Primary navigation">
    {navLinks.map(link => (
      <a
        href={link.href}
        class:list={['site-nav-link', { active: link.key === active }]}
        {...(link.key === active ? { 'aria-current': 'page' } : {})}
      >
        <iconify-icon icon={link.icon} width="16" height="16"></iconify-icon>
        <span>{link.label}</span>
      </a>
    ))}
  </nav>

  {docHeadings && docHeadings.length > 0 ? (
    <div class="site-sidebar-context">
      <p>On this page</p>
      <nav>
        {docHeadings.map(h => (
          <a href={`#${h.id}`} class:list={['site-section-link', `toc-h${h.level}`]} data-toc-id={h.id}>
            <span>{h.text}</span>
            <iconify-icon icon="lucide:chevron-right" width="12" height="12"></iconify-icon>
          </a>
        ))}
      </nav>
    </div>
  ) : sidebarLinks && sidebarLinks.length > 0 ? (
    <div class="site-sidebar-context">
      <p>{sidebarSectionLabel}</p>
      <nav>
        {(() => {
          let lastSection = '';
          return sidebarLinks.map(link => {
            const showSection = link.section && link.section !== lastSection;
            if (showSection) lastSection = link.section;
            const isAnchor = link.href.startsWith('#');
            return (
              <>
                {showSection && <p class="site-sidebar-subsection">{link.section}</p>}
                <a
                  href={link.href}
                  class:list={['site-section-link', { active: link.active }]}
                  data-search-text={(link.label || '').toLowerCase()}
                  data-toc-id={isAnchor ? link.href.slice(1) : undefined}
                >
                  <span>{link.label}</span>
                  <iconify-icon icon="lucide:chevron-right" width="12" height="12"></iconify-icon>
                </a>
              </>
            );
          });
        })()}
      </nav>
    </div>
  ) : null}

  <div class="site-sidebar-footer">
    <div class="sidebar-social-row">
      <a href="https://github.com/AirlinkLabs" target="_blank" rel="noopener" aria-label="GitHub">
        <iconify-icon icon="lucide:github" width="16" height="16"></iconify-icon>
      </a>
      <a href="https://ko-fi.com/airlinklabs" target="_blank" rel="noopener" aria-label="Ko-fi">
        <iconify-icon icon="lucide:coffee" width="16" height="16"></iconify-icon>
      </a>
      <a href="https://discord.gg/CmrDB2tRaN" target="_blank" rel="noopener" aria-label="Discord">
        <svg width="16" height="16" viewBox="0 0 256 199" fill="currentColor"><path d="M216.856 16.597A208.5 208.5 0 0 0 164.042 0c-2.275 4.113-4.933 9.645-6.766 14.046q-29.538-4.442-58.533 0c-1.832-4.4-4.55-9.933-6.846-14.046a207.8 207.8 0 0 0-52.855 16.638C5.618 67.147-3.443 116.4 1.087 164.956c22.169 16.555 43.653 26.612 64.775 33.193A161 161 0 0 0 79.735 175.3a136.4 136.4 0 0 1-21.846-10.632a109 109 0 0 0 5.356-4.237c42.122 19.702 87.89 19.702 129.51 0a132 132 0 0 0 5.355 4.237a136 136 0 0 1-21.886 10.653c4.006 8.02 8.638 15.67 13.873 22.848c21.142-6.58 42.646-16.637 64.815-33.213c5.316-56.288-9.08-105.09-38.056-148.36M85.474 135.095c-12.645 0-23.015-11.805-23.015-26.18s10.149-26.2 23.015-26.2s23.236 11.804 23.015 26.2c.02 14.375-10.148 26.18-23.015 26.18m85.051 0c-12.645 0-23.014-11.805-23.014-26.18s10.148-26.2 23.014-26.2c12.867 0 23.236 11.804 23.015 26.2c0 14.375-10.148 26.18-23.015 26.18"/></svg>
      </a>
      <a href="#" id="about-btn" aria-label="About">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      </a>
    </div>
  </div>
</aside>
