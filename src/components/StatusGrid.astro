---
interface StatusItem {
  label: string;
  value: number;
}

interface Props {
  title?: string;
  items: StatusItem[];
}

const { title, items } = Astro.props;

function statusMeta(value: number) {
  if (value >= 100) return { text: "done", color: "#22c55e", bg: "#dcfce7" };
  if (value >= 50) return { text: "partial", color: "#eab308", bg: "#fef9c3" };
  return { text: "wip", color: "#3b82f6", bg: "#dbeafe" };
}
---

<div class="status-grid">
  {title && <h3 class="status-grid__title">{title}</h3>}
  <div class="status-grid__items">
    {
      items.map((item) => {
        const { text, color, bg } = statusMeta(item.value);
        return (
          <div class="status-grid__item">
            <span
              class="status-grid__badge"
              style={`color: ${color}; background: ${bg};`}
            >
              {text}
            </span>
            <span class="status-grid__label">{item.label}</span>
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .status-grid {
    margin: 2rem 0;
  }

  .status-grid__title {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .status-grid__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
  }

  .status-grid__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 0.5rem;
    background: var(--color-surface, #fff);
  }

  .status-grid__badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2em 0.55em;
    border-radius: 0.25rem;
  }

  .status-grid__label {
    font-size: 0.875rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
