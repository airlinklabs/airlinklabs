{
  "name": "airlink-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "build": "npm run cache && npm run cache:licenses && astro build",
    "preview": "astro preview",
    "cache": "tsx scripts/cache-github.ts",
    "cache:licenses": "tsx scripts/cache-licenses.ts",
    "astro": "astro"
  },
  "site": {
    "title": "AirLink",
    "description": "Open-source game server management panel. Built with TypeScript, runs on your hardware.",
    "versionLabel": "v2.0.0-rc1",
    "siteUrl": "https://airlinklabs.github.io/home",
    "githubOrg": "airlinklabs",
    "githubPanel": "airlinklabs/panel",
    "githubDaemon": "airlinklabs/daemon",
    "discordUrl": "https://discord.gg/CmrDB2tRaN",
    "installVideoUrl": "https://youtu.be/-rGvbc1sVlI?si=MKfYOisLjJJKPMhe"
  },
  "underConstruction": {
    "enabled": true,
    "message": "The site is currently being updated. That means its NOT FINISHED AND IS BEING BUILT!!!!!!",
    "badge": "Under Construction"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/fs-extra": "^11.0.4",
    "better-sqlite3": "^13.0.3",
    "fs-extra": "^11.4.0",
    "tsx": "^4.23.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
