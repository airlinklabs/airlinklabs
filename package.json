{
  "name": "airlink-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run cache && tsx src/scripts/build.ts && npm run tw",
    "tw": "npx @tailwindcss/cli -i src/input.css -o dist/public/css/styles.css --minify",
    "tw:watch": "npx @tailwindcss/cli -i src/input.css -o dist/public/css/styles.css --watch",
    "dev": "tsx src/scripts/dev.ts",
    "cache": "tsx src/scripts/cache-github.ts"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "better-sqlite3": "^13.0.3",
    "ejs": "^3.1.10",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.3.0",
    "marked": "^18.0.5",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "prettier": "3.9.6",
    "prettier-plugin-ejs": "^1.0.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "site": {
    "title": "AirLink",
    "description": "Open-source game server management panel. Built with TypeScript, runs on your hardware.",
    "versionLabel": "v2.0.0-rc1",
    "siteUrl": "https://airlinklabs.github.io/home",
    "githubOrg": "AirlinkLabs",
    "githubPanel": "AirlinkLabs/panel",
    "githubDaemon": "AirlinkLabs/daemon",
    "discordUrl": "https://discord.gg/D8YbT9rDqz",
    "installVideoUrl": "https://youtu.be/-rGvbc1sVlI?si=MKfYOisLjJJKPMhe",
    "ytURL": "https://youtu.be/-rGvbc1sVlI?si=MKfYOisLjJJKPMhe",
    "ytVidIFrame": false
  },
  "underConstruction": {
    "enabled": false,
    "message": "The site is currently being updated.",
    "badge": "Under Construction"
  }
}
